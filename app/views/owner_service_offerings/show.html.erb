<div class="container wa-services ws-owner-page my-4 my-sm-5" id="owner-service-detail">
  <% banner_metadata = capture do %>
    <p class="rc-hint"><i class="bi bi-person-check" aria-hidden="true"></i> <%= owner_capability_title((@draft || @approved || @published).source_capability_domain, (@draft || @approved || @published).professional_capability.delivery_mode) %></p>
  <% end %>
  <% banner_actions = capture do %>
    <%= link_to rc_icon_label("stars", t("owner_services.copilot_action")), owner_catalogue_ai_path,
            class: "rc-action rc-action--quiet" %>
      <% if @draft %>
        <%= link_to rc_icon_label("pencil-square", t("owner_ai_assistant.context_action")),
                    owner_ai_assistant_path(operation: "service_copy", offering_id: @offering.id),
                    class: "rc-action rc-action--quiet" %>
      <% end %>
      <%= link_to rc_icon_label("arrow-left", t("owner_services.back")), owner_services_path, class: "rc-action rc-action--quiet" %>
  <% end %>
  <%= render "shared/wa_banner", variant: :detail, icon: "briefcase", path: t("owner_services.eyebrow"), title: (@draft || @approved || @published).title, extra_class: "rc-page-hero mb-4", metadata: banner_metadata, actions: banner_actions %>
  <section class="surface-panel wa-services__notice mb-4">
    <i class="bi bi-shield-lock" aria-hidden="true"></i>
    <div><strong><%= t("owner_services.private_title") %></strong><p><%= t("owner_services.private_help") %></p></div>
  </section>
  <div class="wa-services__detail">
    <main class="wa-services__main">
      <% if @draft %>
        <section class="surface-panel wa-services__panel" id="offering-draft">
          <h2><i class="bi bi-pencil-square" aria-hidden="true"></i> <%= t("owner_services.draft_label") %></h2>
          <p class="rc-hint"><%= t("owner_services.draft_help") %></p>
          <%= form_with url: owner_service_draft_path(@offering), method: :patch, html: { class: "rc-form", id: "offering-draft-form" } do %>
            <%= hidden_field_tag :base_version, @draft.version %>
            <%= hidden_field_tag :base_digest, @draft.digest %>
            <%= render "fields", values: @draft.attributes, creating: false, draft: @draft, capabilities: @eligible_capabilities %>
            <%= button_tag type: "submit", class: "rc-action rc-action--primary" do %><%= rc_icon_label("floppy", t("owner_services.save_draft")) %><% end %>
          <% end %>
        </section>
        <section class="surface-panel wa-services__panel" id="offering-approval">
          <h2><i class="bi bi-shield-check" aria-hidden="true"></i> <%= t("owner_services.approval_title") %></h2>
          <% if @eligible %>
            <p><%= t("owner_services.approval_help") %></p>
            <%= form_with url: approve_owner_service_path(@offering), method: :post do %>
              <%= hidden_field_tag :version, @draft.version %>
              <%= hidden_field_tag :digest, @draft.digest %>
              <%= hidden_field_tag :confirm, "1" %>
              <%= button_tag type: "submit", class: "rc-action rc-action--primary" do %>
                <%= rc_icon_label("patch-check", t("owner_services.finalize_one")) %>
              <% end %>
            <% end %>
          <% else %>
            <p class="rc-notice rc-notice--neutral"><%= t("owner_services.pending_context") %></p>
          <% end %>
        </section>
      <% elsif @approved %>
        <section class="surface-panel wa-services__panel" id="offering-approved">
          <h2><i class="bi bi-patch-check" aria-hidden="true"></i> <%= t("owner_services.final_label") %></h2>
          <p class="rc-hint"><%= t("owner_services.immutable") %></p>
          <h3><%= @approved.title %></h3>
          <p class="wa-services__prose"><%= @approved.summary %></p>
          <dl class="wa-services__boundaries">
            <dt><%= t("owner_services.included_scope") %></dt><dd><%= @approved.included_scope %></dd>
            <dt><%= t("owner_services.excluded_scope") %></dt><dd><%= @approved.excluded_scope %></dd>
            <% if @approved.requirements_prompt.present? %><dt><%= t("owner_services.requirements_prompt") %></dt><dd><%= @approved.requirements_prompt %></dd><% end %>
          </dl>
          <%= button_to rc_icon_label("files", t("owner_services.new_revision")), revise_owner_service_path(@offering), method: :post, class: "rc-action rc-action--quiet" %>
        </section>
      <% end %>
      <% presentation = @draft || @approved || @published %>
      <% if presentation %>
        <section class="surface-panel wa-services__panel" id="offering-client-preview">
          <h2><i class="bi bi-eye" aria-hidden="true"></i> <%= t("owner_services.client_preview", default: "Client preview") %></h2>
          <p class="rc-hint"><%= t("owner_services.client_preview_help", default: "Review the title, client benefit and deliverables before publishing. This preview does not publish changes.") %></p>
          <h3><%= presentation.title %></h3>
          <p><%= presentation.summary %></p>
          <strong><%= t("owner_services.included_scope") %></strong>
          <ul class="ws-owner-boundaries">
            <% presentation.included_scope.split(/\r?\n|;\s*/).reject(&:blank?).each do |item| %>
              <li><i class="bi bi-check2" aria-hidden="true"></i><span><%= item %></span></li>
            <% end %>
          </ul>
          <% if @published && presentation.id != @published.id %>
            <p class="rc-hint"><%= t("owner_services.client_preview_pending", default: "Clients still see the previously published version.") %></p>
          <% end %>
        </section>
      <% end %>
      <% if @approved %>
        <section class="surface-panel wa-services__panel" id="offering-publication">
          <h2><i class="bi bi-eye" aria-hidden="true"></i> <%= t("owner_services.publication_title") %></h2>
          <p class="rc-hint"><%= t("owner_services.publication_help") %></p>
          <% if @published %>
            <p class="wa-services__state wa-services__state--enabled"><%= t("owner_services.enabled_version", version: @published.version) %></p>
            <%= button_to rc_icon_label("eye-slash", t("owner_services.unpublish_action")), unpublish_owner_service_path(@offering),
                          method: :post, params: { confirm: "1" }, class: "rc-action rc-action--quiet" %>
          <% end %>
          <% if @eligible_capabilities.any? && @approved.professional_context_snapshot_id == @snapshot&.id && @profile.onboarding_state == "approved" && @profile.professional_capability_corrections.none? && @published&.id != @approved.id %>
            <%= form_with url: publish_owner_service_path(@offering), method: :post do %>
              <%= hidden_field_tag :version_id, @approved.id %>
              <%= hidden_field_tag :digest, @approved.digest %>
              <div class="wa-services__check"><%= check_box_tag :confirm, "1", false, required: true, id: "confirm-offering-publication" %>
                <%= label_tag "confirm-offering-publication", t("owner_services.confirm_publication") %></div>
              <%= button_tag type: "submit", class: "rc-action rc-action--primary" do %><%= rc_icon_label("eye", t("owner_services.publish_action")) %><% end %>
            <% end %>
          <% elsif @approved.professional_context_snapshot_id != @snapshot&.id %>
            <p class="rc-notice rc-notice--neutral"><%= t("owner_services.stale_context") %></p>
          <% end %>
        </section>
      <% end %>
        <% if @media_enabled %>
        <section class="surface-panel wa-services__panel wa-services__media-section" id="offering-media">
          <h2><i class="bi bi-images" aria-hidden="true"></i> <%= t("owner_services.media_title") %></h2>
          <p class="rc-hint"><%= t("owner_services.media_private_notice") %></p>

          <div class="wa-services__media-gallery">
            <% @media_items.each do |media| %>
              <article class="wa-services__media-item">
                <% if media.image? %>
                  <%= image_tag owner_service_media_file_path(@offering, media),
                        alt: media.caption.presence || t("owner_services.media_image_alt"),
                        class: "wa-services__media-thumb", loading: "lazy" %>
                <% else %>
                  <div class="wa-services__media-placeholder" aria-hidden="true"><i class="bi <%= case media.media_kind
                        when "document" then "bi-file-earmark-text"
                        when "audio" then "bi-file-earmark-music"
                        else "bi-file-earmark-play" end %>"></i></div>
                <% end %>
                <div class="wa-services__media-meta">
                  <strong><i class="bi bi-paperclip" aria-hidden="true"></i>
                    <%= media.caption.presence || t("owner_services.media_kinds.#{media.media_kind}") %></strong>
                  <small><%= t("owner_services.media_kinds.#{media.media_kind}") %> ·
                    <%= t("owner_services.version", version: media.service_offering_version.version) %></small>
                </div>
                <span class="wa-services__state wa-services__state--<%= media.approved? ? "approved" : "draft" %>">
                  <i class="bi bi-<%= media.approved? ? "patch-check" : "clock-history" %>" aria-hidden="true"></i>
                  <%= t(media.approved? ? "owner_services.media_reviewed" : "owner_services.media_pending_review") %>
                </span>
                <div class="wa-services__media-actions">
                  <%= link_to rc_icon_label("download", t("owner_services.media_download")),
                        owner_service_media_file_path(@offering, media), class: "rc-action rc-action--quiet rc-action--small" %>
                  <% unless media.approved? %>
                    <%= button_to rc_icon_label("patch-check", t("owner_services.media_approve")),
                          approve_owner_service_media_path(@offering, media),
                          method: :post, form: { class: "wa-services__inline-form" },
                          class: "rc-action rc-action--soft rc-action--small" %>
                  <% end %>
                  <%= button_to rc_icon_label("archive", t("owner_services.media_archive")),
                        archive_owner_service_media_path(@offering, media),
                        method: :delete, form: { class: "wa-services__inline-form", data: { turbo_confirm: t("owner_services.media_archive_confirm") } },
                        class: "rc-action rc-action--quiet rc-action--small" %>
                </div>
              </article>
            <% end %>
          </div>

          <h3 class="wa-services__media-subheading"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> <%= t("owner_services.media_upload_title") %></h3>
          <%= form_with url: owner_service_media_items_path(@offering), method: :post,
                        multipart: true, html: { class: "rc-form wa-services__media-form", id: "offering-media-upload" } do %>
            <div class="rc-field">
              <%= label_tag :media_kind, t("owner_services.media_kind"), class: "rc-field-label" %>
              <%= select_tag "media[media_kind]",
                  options_for_select(ServiceOfferingMediaItem::KINDS.map { |kind| [t("owner_services.media_kinds.#{kind}"), kind] }),
                  id: :media_kind, class: "rc-input", required: true %>
            </div>
            <div class="rc-field">
              <%= label_tag :media_file, t("owner_services.media_file"), class: "rc-field-label" %>
              <div class="wa-file-drop">
                <label for="media_file"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                  <%= t("owner_services.media_choose_file") %></label>
                <%= file_field_tag "media[file]", id: :media_file, required: true,
                      accept: ServiceOfferingMediaItem::ALLOWED_MIME_TYPES.values.flatten.uniq.join(",") %>
              </div>
              <p class="rc-hint"><%= t("owner_services.media_limits") %></p>
            </div>
            <div class="rc-field">
              <%= label_tag :media_caption, t("owner_services.media_caption"), class: "rc-field-label" %>
              <%= text_field_tag "media[caption]", nil, id: :media_caption, maxlength: 160, class: "rc-input" %>
            </div>
            <%= button_tag type: "submit", class: "rc-action rc-action--primary" do %>
              <%= rc_icon_label("cloud-arrow-up", t("owner_services.media_upload")) %>
            <% end %>
          <% end %>
          <p class="rc-hint wa-services__media-ai-notice">
            <i class="bi bi-shield-lock" aria-hidden="true"></i> <%= t("owner_services.media_ai_off") %>
          </p>
        </section>
      <% end %>
    </main>
    <aside class="wa-services__aside">
      <% source = @draft || @approved || @published %>
      <section class="surface-panel wa-services__panel">
        <h2><i class="bi bi-link-45deg" aria-hidden="true"></i> <%= t("owner_services.source_title") %></h2>
        <p><strong><%= owner_capability_title(source.source_capability_domain, source.professional_capability.delivery_mode) %></strong></p>
        <p class="rc-hint"><%= t("owner_services.snapshot_version", version: source.professional_context_snapshot.version) %> · <%= t("owner_services.modes.#{source.delivery_mode}") %></p>
        <p class="rc-hint"><%= t("owner_services.self_reported") %></p>
        <% if @policy %>
          <details class="wa-services__restrictions">
            <summary><i class="bi bi-shield-exclamation" aria-hidden="true"></i> <%= t("owner_services.policy_title") %>
              <i class="bi bi-chevron-down wa-services__chevron" aria-hidden="true"></i></summary>
            <div class="wa-services__restriction-content">
              <ul><% Array(@policy.hard_no_go).each do |code| %>
                <li><%= t("owner_setup.options.D.#{code}", default: code) %></li>
              <% end %></ul>
            </div>
          </details>
        <% end %>
      </section>
      <section class="surface-panel wa-services__panel">
        <h2><i class="bi bi-clock-history" aria-hidden="true"></i> <%= t("owner_services.history") %></h2>
        <ol class="wa-services__history">
          <% @history.each do |row| %>
            <li><strong><%= t("owner_services.version", version: row.version) %></strong>
              <span><%= row.approved? ? t("owner_services.approved_label") : t("owner_services.draft_label") %></span>
              <small><%= l(row.created_at, format: :short) %></small></li>
          <% end %>
        </ol>
        <% if @publications.any? %><h3><%= t("owner_services.audit") %></h3>
          <ol class="wa-services__history">
            <% @publications.each do |event| %><li><strong><%= t("owner_services.event_#{event.event}") %></strong><small><%= l(event.created_at, format: :short) %></small></li><% end %>
          </ol>
        <% end %>
        <details class="wa-services__technical">
          <summary><i class="bi bi-code-slash" aria-hidden="true"></i> <%= t("owner_services.technical_details") %></summary>
          <p><%= t("owner_services.record_key", key: @offering.key) %></p>
          <% @history.each do |row| %>
            <p><%= t("owner_services.version", version: row.version) %> ·
              <%= t("owner_services.snapshot_version", version: row.professional_context_snapshot.version) %> ·
              SHA <%= row.digest.first(12) %></p>
          <% end %>
        </details>
      </section>
    </aside>
  </div>
</div>
