<div class="rc-account-content rc-account-content--wide">
  <%= render "shared/account_heading",
             icon: "shield-check", eyebrow: t("auth.privacy.eyebrow"),
             title: t("auth.privacy.title"),
             description: t("auth.privacy.description") %>
  <section class="rc-account-panel rc-account-policy" aria-label="<%= t('auth.privacy.panel') %>">
    <h2><%= t("auth.privacy.data_title") %></h2>
    <p><%= t("auth.privacy.data_body") %></p>
    <h2><%= t("auth.privacy.email_title") %></h2>
    <p><%= t("auth.privacy.email_body") %></p>
    <h2><%= t("auth.privacy.security_title") %></h2>
    <p><%= t("auth.privacy.security_body") %></p>
    <h2><%= t("auth.privacy.release_title") %></h2>
    <p><%= t("auth.privacy.release_body") %></p>
    <%= link_to rc_icon_label("arrow-left", t("auth.privacy.back")),
                client_registration_path, class: "rc-account-option" %>
  </section>
</div>
