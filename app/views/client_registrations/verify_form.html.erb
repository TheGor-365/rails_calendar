<div class="mk-auth-shell">
  <div class="mk-auth-heading"><span class="mk-kicker"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#lock"></use></svg> ПОДТВЕРЖДЕНИЕ ПОЧТЫ</span>
    <h1>Введите код</h1><p>Если адрес доступен для регистрации, сообщение с шестизначным кодом отправлено на <strong><%= @masked_email %></strong>. Код действует 10 минут.</p></div>
  <% if notice.present? %><p class="mk-auth-notice" role="status"><%= notice %></p><% end %>
  <% if alert.present? %><p class="mk-auth-alert" role="alert"><%= alert %></p><% end %>
  <section class="mk-auth-panel">
    <%= form_with url: verify_client_registration_path, method: :post, local: true, html: { class: "mk-auth-form" } do |f| %>
      <div><%= f.label :code, "Код подтверждения" %><%= f.text_field :code, required: true, maxlength: 6, minlength: 6, pattern: "[0-9]{6}", inputmode: "numeric", autocomplete: "one-time-code", placeholder: "000000", class: "mk-auth-code" %></div>
      <%= f.button type: :submit, class: "mk-action mk-action-primary" do %><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#check"></use></svg> Подтвердить email<% end %>
    <% end %>
    <div class="mk-auth-resend"><span>Не получили письмо?</span>
      <%= button_to "Отправить снова", resend_client_registration_path, method: :post, class: "mk-auth-secondary" %></div>
  </section>
  <p class="mk-auth-foot"><%= link_to "Указать другой email", client_registration_path %></p>
</div>
