<div class="rc-account-content">
  <%= render "shared/account_heading",
             icon: "person-plus", eyebrow: "АККАУНТ / РЕГИСТРАЦИЯ",
             title: "Создать аккаунт",
             description: "Подтвердите адрес одноразовым кодом, чтобы войти в собственную рабочую область." %>
  <section class="rc-account-panel" aria-label="Регистрация клиента">
    <%= form_with url: client_registration_path, scope: :signup, local: true,
                  html: { class: "rc-account-form rc-form" } do |form| %>
      <div class="rc-field">
        <%= form.label :email, "Электронная почта", class: "rc-field-label" %>
        <%= form.email_field :email, required: true, maxlength: 254, autocomplete: "email",
                             placeholder: "you@example.com", class: "rc-input" %>
      </div>
      <div class="rc-field">
        <%= form.label :password, "Пароль (минимум 12 символов)", class: "rc-field-label" %>
        <%= form.password_field :password, required: true, minlength: 12, maxlength: 72,
                                 autocomplete: "new-password", class: "rc-input" %>
      </div>
      <div class="rc-field">
        <%= form.label :password_confirmation, "Повторите пароль", class: "rc-field-label" %>
        <%= form.password_field :password_confirmation, required: true, minlength: 12, maxlength: 72,
                                 autocomplete: "new-password", class: "rc-input" %>
      </div>
      <div class="rc-account-consent">
        <%= form.check_box :consent, { required: true, class: "rc-account-checkbox" }, "1", "0" %>
        <%= form.label :consent do %>
          Согласен на обработку email и данных аккаунта. <%= link_to rc_icon_label("shield-check", "Условия обработки"), ClientSignupAvailability.privacy_url, class: "rc-account-inline-link" %>
        <% end %>
      </div>
      <div class="rc-account-form-actions">
        <%= form.button type: :submit, class: "rc-action rc-action--primary" do %>
          <%= rc_icon_label("envelope-arrow-up", "Получить код") %>
        <% end %>
      </div>
    <% end %>
    <div class="rc-account-alternatives">
      <span>Уже зарегистрированы?</span>
      <%= link_to rc_icon_label("box-arrow-in-right", "Войти"), sign_in_path, class: "rc-account-option" %>
    </div>
  </section>
</div>
