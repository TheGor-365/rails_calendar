<div class="simple-calendar">
  <nav class="calendar-heading d-flex align-items-center justify-content-between gap-3 mb-3"
       aria-label="Calendar month navigation">
    <%= link_to t('simple_calendar.previous', default: 'Previous'), calendar.url_for_previous_view,
                class: "rc-navigation-link", aria: { label: "Previous month" } %>
    <h2 class="calendar-title" aria-live="polite">
      <%= t('date.month_names')[start_date.month] %> <span><%= start_date.year %></span>
    </h2>
    <%= link_to t('simple_calendar.next', default: 'Next'), calendar.url_for_next_view,
                class: "rc-navigation-link", aria: { label: "Next month" } %>
  </nav>

  <div class="calendar-scroll-region" role="region"
       aria-label="<%= start_date.strftime('%B %Y') %> consultation calendar"
       tabindex="0">
    <table class="calendar-grid">
      <caption class="visually-hidden"><%= start_date.strftime('%B %Y') %> consultation calendar</caption>
      <thead>
        <tr>
          <% date_range.slice(0, 7).each do |day| %>
            <th scope="col"><%= t('date.abbr_day_names')[day.wday] %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% date_range.each_slice(7) do |week| %>
          <tr>
            <% week.each do |day| %>
              <%= content_tag :td, class: calendar.td_classes_for(day) do %>
                <% if defined?(Haml) && respond_to?(:block_is_haml?) && block_is_haml?(passed_block) %>
                  <% capture_haml(day, sorted_events.fetch(day, []), &passed_block) %>
                <% else %>
                  <% passed_block.call day, sorted_events.fetch(day, []) %>
                <% end %>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="rc-hint mt-2">Swipe the month grid horizontally on narrow screens. Open a date to see all events by hour.</p>
</div>
