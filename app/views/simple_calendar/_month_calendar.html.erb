<div class="simple-calendar">
  <nav class="calendar-heading d-flex align-items-center justify-content-between gap-3 mb-3"
       aria-label="<%= t("calendar.calendar_month_nav") %>">
    <%= link_to rc_icon_label('chevron-left', t('simple_calendar.previous')), calendar.url_for_previous_view,
                class: "rc-navigation-link", aria: { label: t("calendar.previous_month") } %>
    <h2 class="calendar-title" aria-live="polite">
      <%= rc_local_date(start_date, format: :rc_month).sub(/\s+\d{4}\z/, "") %> <span><%= start_date.year %></span>
    </h2>
    <%= link_to rc_icon_label('chevron-right', t('simple_calendar.next')), calendar.url_for_next_view,
                class: "rc-navigation-link", aria: { label: t("calendar.next_month") } %>
  </nav>

  <div class="calendar-scroll-region" role="region"
       aria-label="<%= t("calendar.month_region_aria", month: rc_local_date(start_date, format: :rc_month)) %>"
       tabindex="0">
    <table class="calendar-grid">
      <caption class="visually-hidden"><%= t("calendar.month_region_aria", month: rc_local_date(start_date, format: :rc_month)) %></caption>
      <thead>
        <tr>
          <% date_range.slice(0, 7).each do |day| %>
            <th scope="col"><%= t('date.abbr_day_names')[day.wday] %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% date_range.each_slice(7) do |week| %>
          <tr>
            <% week.each do |day| %>
              <%= content_tag :td, class: calendar.td_classes_for(day) do %>
                <% if defined?(Haml) && respond_to?(:block_is_haml?) && block_is_haml?(passed_block) %>
                  <% capture_haml(day, sorted_events.fetch(day, []), &passed_block) %>
                <% else %>
                  <% passed_block.call day, sorted_events.fetch(day, []) %>
                <% end %>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="rc-hint mt-2"><%= t("calendar.month_help") %></p>
</div>
