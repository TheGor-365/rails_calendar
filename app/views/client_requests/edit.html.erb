<div class="container wa-client-form my-4 my-sm-5">
  <header class="rc-page-hero mb-4"><div class="rc-page-hero__content">
    <p class="eyebrow"><%= t("e2.guest_eyebrow") %></p>
    <div class="rc-page-hero__heading"><span class="rc-page-hero__symbol" aria-hidden="true"><i class="bi bi-pencil-square"></i></span>
      <h1 class="page-title"><%= t("e2.edit_title") %></h1></div>
    <p class="rc-muted"><%= t("e2.edit_hint") %></p>
  </div></header>

  <section class="surface-panel p-3 p-sm-4 mb-3">
    <h2 class="h5"><%= t("e2.owner_seed_title") %></h2>
    <p class="rc-hint"><%= t("e2.owner_seed_warning") %></p>
    <p><strong><%= @invitation.seed_title %></strong></p>
    <p class="wa-prose"><%= @invitation.seed_goal %></p>
  </section>

  <section class="surface-panel p-3 p-sm-4 mb-3">
    <% if @intake.errors.any? %>
      <p class="rc-notice rc-notice--error" role="alert"><%= @intake.errors.full_messages.to_sentence %></p>
    <% end %>
    <p class="rc-hint"><%= t("e2.review_required") %></p>
    <%= form_with model: @intake, url: client_request_path(@intake), method: :patch,
                  html: { class: "rc-form" } do |f| %>
      <% brief = @intake.latest_brief_revision %>
      <section class="wa-e2-client-brief" aria-labelledby="wa-e2-client-brief-heading">
        <div class="wa-invite-field-heading">
          <span class="wa-invite-section-icon" aria-hidden="true"><i class="bi bi-translate"></i></span>
          <div>
            <h2 id="wa-e2-client-brief-heading"><%= t("e2_client_brief.title") %></h2>
            <p class="rc-hint"><%= t("e2_client_brief.intro") %></p>
          </div>
        </div>
        <% InvitationBriefTaxonomy.sections.each do |group, options| %>
          <details class="wa-e2-client-brief__disclosure" <%= "open" if group == "tasks" %>>
            <summary>
              <i class="bi <%= InvitationBriefTaxonomy::ICONS.fetch(group) %>" aria-hidden="true"></i>
              <span><%= t("e2_client_brief.groups.#{group}") %></span>
              <i class="bi bi-chevron-down wa-e2-client-brief__chevron" aria-hidden="true"></i>
            </summary>
          <fieldset class="wa-e2-client-brief__section">
            <legend class="visually-hidden"><%= t("e2_client_brief.groups.#{group}") %></legend>
            <p class="rc-hint"><%= t("e2_client_brief.group_help.#{group}") %></p>
            <div class="wa-e2-client-brief__choices">
              <% options.each do |option| %>
                <label class="wa-e2-client-brief__choice">
                  <input type="checkbox" name="brief[selections][<%= group %>][]" value="<%= option %>"
                         <%= "checked" if Array(brief&.selections&.fetch(group, [])).include?(option) %>>
                  <span>
                    <strong><%= t("e2_builder.options.#{option}") %></strong>
                    <small><%= t("e2_client_brief.explain.#{option}") %></small>
                  </span>
                </label>
              <% end %>
            </div>
            <label class="wa-e2-client-brief__decision">
              <span><%= t("e2_client_brief.uncertain") %></span>
              <%= select_tag "brief[decisions][#{group}]",
                  options_for_select([
                    [t("e2_builder.skip"), "skip"],
                    [t("e2_builder.client_decides"), "client"],
                    [t("e2_builder.owner_decides"), "owner"]
                  ], brief&.decisions&.fetch(group, "skip") || "skip"),
                  class: "rc-input" %>
            </label>
          </fieldset>
          </details>
        <% end %>
        <div class="rc-field">
          <%= label_tag "brief_notes", t("e2_client_brief.notes"), class: "rc-field-label" %>
          <%= text_area_tag "brief[notes]", brief&.notes, id: "brief_notes",
                maxlength: 350, rows: 2, class: "rc-input rc-input--area",
                placeholder: t("e2_client_brief.notes_placeholder") %>
        </div>
        <p class="rc-hint"><i class="bi bi-shield-check" aria-hidden="true"></i>
          <%= t("e2_client_brief.no_auto_ai") %></p>
      </section>
      <div class="rc-field mb-3">
        <%= f.label :title, t("intake.field_title"), class: "rc-field-label" %>
        <%= f.text_field :title, class: "rc-input", maxlength: 120, required: true %>
        <%= label_tag "fact_review_title", t("e2.fact_review"), class: "rc-field-label mt-2" %>
        <%= select_tag "fact_review[title]",
              options_for_select([
                [t("e2.fact_suggested"), "suggested"],
                [t("e2.fact_confirmed"), "confirmed"],
                [t("e2.fact_unknown"), "unknown"]
              ], @invitation.fact_state("title")),
              id: "fact_review_title", class: "rc-input" %>
      </div>
      <div class="rc-field mb-3">
        <%= f.label :project_type, t("intake.field_type"), class: "rc-field-label" %>
        <%= f.select :project_type,
             ProjectIntake::TYPES.map { |type| [rc_intake_type(type), type] }, {}, class: "rc-input" %>
        <%= label_tag "fact_review_project_type", t("e2.fact_review"), class: "rc-field-label mt-2" %>
        <%= select_tag "fact_review[project_type]",
              options_for_select([
                [t("e2.fact_suggested"), "suggested"],
                [t("e2.fact_confirmed"), "confirmed"],
                [t("e2.fact_unknown"), "unknown"]
              ], @invitation.fact_state("project_type")),
              id: "fact_review_project_type", class: "rc-input" %>
      </div>
      <div class="rc-field mb-3">
        <%= f.label :goal, t("intake.field_goal"), class: "rc-field-label" %>
        <%= f.text_area :goal, class: "rc-input rc-input--area", rows: 5,
              minlength: 10, maxlength: 1200, required: true,
              data: { controller: "wa-autogrow", action: "input->wa-autogrow#resize" } %>
        <%= label_tag "fact_review_goal", t("e2.fact_review"), class: "rc-field-label mt-2" %>
        <%= select_tag "fact_review[goal]",
              options_for_select([
                [t("e2.fact_suggested"), "suggested"],
                [t("e2.fact_confirmed"), "confirmed"],
                [t("e2.fact_unknown"), "unknown"]
              ], @invitation.fact_state("goal")),
              id: "fact_review_goal", class: "rc-input" %>
      </div>
      <p class="rc-hint"><%= t("e2.demo_warning") %></p>
      <button type="submit" class="rc-action rc-action--soft"><%= rc_icon_label("floppy", t("e2.save_draft")) %></button>
    <% end %>
  </section>
  <section class="surface-panel p-3 p-sm-4">
    <h2 class="h5"><%= t("e2.submit_title") %></h2>
    <p class="rc-hint"><%= t("e2.submit_hint") %></p>
    <%= button_to rc_icon_label("send", t("e2.submit_action")),
        submit_client_request_path(@intake), method: :post, class: "rc-action rc-action--primary" %>
  </section>
</div>
