<div class="container my-4 my-sm-5">
  <header class="rc-page-hero mb-4">
    <div class="rc-page-hero__content">
      <p class="eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> <%= t("client_requests.eyebrow") %></p>
      <div class="rc-page-hero__heading"><span class="rc-page-hero__symbol" aria-hidden="true"><i class="bi bi-kanban"></i></span><h1 class="page-title"><%= @intake.title %></h1></div>
      <p class="rc-muted"><%= t("client_requests.status", type: rc_intake_type(@intake.project_type), status: rc_intake_status(@intake.status)) %></p>
      <%= link_to rc_icon_label("arrow-left", t("client_requests.back")), client_home_path, class: "rc-action rc-action--quiet rc-action--small" %>
    </div>
  </header>
  <section class="surface-panel p-3 p-sm-4 mb-4" aria-labelledby="client-request-description">
    <h2 class="h4" id="client-request-description"><%= t("client_requests.description_title") %></h2>
    <p class="mb-0"><%= @intake.goal %></p>
    <p class="rc-hint mt-3"><%= t("client_requests.demo_warning") %></p>
  </section>
  <section class="surface-panel p-3 p-sm-4 mb-4" aria-labelledby="client-request-spec">
    <h2 class="h4" id="client-request-spec"><i class="bi bi-file-earmark-text me-2" aria-hidden="true"></i><%= t("client_requests.spec_title") %></h2>
    <% if @spec %>
      <p class="rc-hint"><%= t("client_requests.spec_version", version: @spec.version) %> · <%= t("client_requests.not_contract") %></p>
      <p><%= @spec.document["summary"] %></p>
      <% {"goals" => "section_goals", "deliverables" => "section_deliverables",
           "acceptance_criteria" => "section_acceptance_criteria", "unknowns" => "section_unknowns",
           "exclusions" => "section_exclusions"}.each do |key, translation_key| %>
        <h3 class="h5 mt-4"><%= t("intake.#{translation_key}") %></h3>
        <ul><% Array(@spec.document[key]).each do |line| %><li><%= line %></li><% end %></ul>
      <% end %>
      <% if @spec.client_reviewed_at.nil? %>
        <%= button_to rc_icon_label("check2-circle", t("client_requests.review_action")),
          review_client_request_path(@intake), method: :post,
          params: { version: @spec.version }, class: "rc-action rc-action--primary" %>
      <% else %>
        <p class="rc-notice rc-notice--success" role="status"><%= t("client_requests.reviewed") %></p>
      <% end %>
    <% else %>
      <p class="rc-muted"><%= t("client_requests.spec_pending") %></p>
    <% end %>
  </section>
  <% if @milestones.any? %>
    <section class="surface-panel p-3 p-sm-4" aria-labelledby="client-request-milestones">
      <h2 id="client-request-milestones" class="h4"><i class="bi bi-calendar-range me-2" aria-hidden="true"></i><%= t("client_requests.milestones_title") %></h2>
      <ol class="rc-record-list">
        <% @milestones.each do |milestone| %>
          <li class="rc-record">
            <strong><%= milestone.title %></strong>
            <p class="rc-muted mb-0"><%= milestone.start_on %> – <%= milestone.end_on %> · <%= t("client_requests.tentative") %></p>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>
</div>
