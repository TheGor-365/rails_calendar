<div class="container wa-client-request my-4 my-sm-5">
  <header class="rc-page-hero mb-4">
    <div class="rc-page-hero__content">
      <p class="eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> <%= t("client_requests.eyebrow") %></p>
      <div class="rc-page-hero__heading">
        <span class="rc-page-hero__symbol" aria-hidden="true"><i class="bi bi-kanban"></i></span>
        <h1 class="page-title"><%= @intake.title %></h1>
      </div>
      <div class="wa-client-request__meta">
        <span class="rc-status-pill rc-status-pill--muted"><i class="bi bi-grid-1x2" aria-hidden="true"></i><%= rc_intake_type(@intake.project_type) %></span>
        <span class="rc-status-pill"><i class="bi bi-circle-half" aria-hidden="true"></i><%= rc_intake_status(@intake.status) %></span>
        <% if @spec %>
          <span class="rc-status-pill rc-status-pill--muted"><i class="bi bi-file-earmark-check" aria-hidden="true"></i><%= t("client_requests.spec_version", version: @spec.version) %></span>
        <% end %>
      </div>
      <div class="rc-page-hero__actions mt-3">
        <%= link_to rc_icon_label("arrow-left", t("client_requests.back")), client_home_path, class: "rc-action rc-action--quiet rc-action--small" %>
      </div>
    </div>
  </header>

  <section class="surface-panel wa-client-request__panel mb-4" aria-labelledby="client-request-description">
    <div class="wa-client-request__section-head">
      <span class="wa-client-request__section-icon" aria-hidden="true"><i class="bi bi-card-text"></i></span>
      <h2 id="client-request-description"><%= t("client_requests.description_title") %></h2>
    </div>
    <div class="wa-client-request__description wa-prose"><%= @intake.goal %></div>
    <p class="rc-hint wa-client-request__safety"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i><%= t("client_requests.demo_warning") %></p>
  </section>


  <section class="surface-panel wa-client-request__panel wa-client-request__conversation mb-4"
           aria-labelledby="client-request-conversation-heading">
    <div class="wa-client-request__section-head">
      <span class="wa-client-request__section-icon" aria-hidden="true"><i class="bi bi-chat-left-text"></i></span>
      <h2 id="client-request-conversation-heading"><%= t("client_requests.conversation_title") %></h2>
    </div>
    <p class="rc-hint"><%= t("client_requests.conversation_help") %></p>
    <ol class="wa-client-request__thread" id="client-request-conversation">
      <% @conversation.each do |message| %>
        <li class="wa-client-request__message wa-client-request__message--<%= message.role %>">
          <div class="wa-client-request__message-header">
            <strong><i class="bi bi-<%= message.role == "client" ? "person-circle" : "chat-left-dots" %>" aria-hidden="true"></i>
              <%= t("client_requests.message_#{message.role}") %>
            </strong>
            <time datetime="<%= message.created_at.iso8601 %>"><%= message.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %></time>
          </div>
          <p class="wa-client-request__message-body"><%= message.body %></p>
        </li>
      <% end %>
    </ol>

    <% if @reply_error.present? %>
      <p class="rc-notice rc-notice--error" role="alert"><%= @reply_error %></p>
    <% end %>
    <% if @client_turn_count < ProjectIntake::MAX_CLIENT_MESSAGES %>
      <div class="wa-client-request__reply">
        <h3><%= t("client_requests.reply_title") %></h3>
        <p class="rc-hint" id="client-reply-help"><%= t("client_requests.reply_help", remaining: ProjectIntake::MAX_CLIENT_MESSAGES - @client_turn_count) %></p>
        <%= form_with url: reply_client_request_path(@intake), method: :post,
                      html: { class: "rc-form", id: "client-reply-form" } do %>
          <%= hidden_field_tag :submission_key, @reply_submission_key %>
          <div class="rc-field">
            <%= label_tag :reply_body, t("client_requests.reply_label"), class: "rc-field-label" %>
            <%= text_area_tag :reply_body, @reply_body, id: "reply_body",
                rows: 4, maxlength: 1200, required: true,
                class: "rc-input rc-input--area", aria: { describedby: "client-reply-help" },
                placeholder: t("client_requests.reply_placeholder"),
                data: { controller: "wa-autogrow", action: "input->wa-autogrow#resize" } %>
          </div>
          <p class="rc-hint"><%= t("client_requests.demo_warning") %></p>
          <%= button_tag type: "submit", class: "rc-action rc-action--primary" do %>
            <%= rc_icon_label("send", t("client_requests.reply_send")) %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="rc-hint wa-client-request__reply-closed"><%= t("client_requests.reply_limit") %></p>
    <% end %>
  </section>

  <section class="surface-panel wa-client-request__panel mb-4" aria-labelledby="client-request-spec">
    <div class="wa-client-request__section-head">
      <span class="wa-client-request__section-icon" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></span>
      <h2 id="client-request-spec"><%= t("client_requests.spec_title") %></h2>
    </div>
    <% if @spec %>
      <p class="rc-hint"><%= t("client_requests.spec_version", version: @spec.version) %> · <%= t("client_requests.not_contract") %></p>
      <% if @spec.document["summary"].present? %>
        <p class="wa-prose wa-client-request__summary"><%= @spec.document["summary"] %></p>
      <% end %>
      <div class="wa-client-request__spec-sections">
        <% [
          ["goals", "section_goals", "bullseye"],
          ["deliverables", "section_deliverables", "box-seam"],
          ["acceptance_criteria", "section_acceptance_criteria", "clipboard2-check"],
          ["unknowns", "section_unknowns", "question-circle"],
          ["exclusions", "section_exclusions", "slash-circle"]
        ].each do |key, translation_key, icon| %>
          <%= render "shared/white_atlas/spec_section",
            id: "client-spec-#{key}", kind: key.dasherize, icon: icon,
            title: t("intake.#{translation_key}"), items: @spec.document[key] %>
        <% end %>
      </div>
      <div class="wa-client-request__review">
        <% if @spec.client_reviewed_at.nil? %>
          <p class="rc-hint"><%= t("client_requests.not_contract") %></p>
          <%= button_to rc_icon_label("check2-circle", t("client_requests.review_action")),
            review_client_request_path(@intake), method: :post,
            params: { version: @spec.version }, class: "rc-action rc-action--primary" %>
        <% else %>
          <p class="rc-notice rc-notice--success mb-0" role="status"><%= t("client_requests.reviewed") %></p>
        <% end %>
      </div>
    <% else %>
      <div class="rc-empty-state wa-client-request__pending">
        <span class="rc-empty-state__icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
        <h3><%= t("client_requests.spec_pending") %></h3>
        <p><%= t("client_requests.not_contract") %></p>
      </div>
    <% end %>
  </section>

  <% if @milestones.any? %>
    <section class="surface-panel wa-client-request__panel" aria-labelledby="client-request-milestones">
      <div class="wa-client-request__section-head">
        <span class="wa-client-request__section-icon" aria-hidden="true"><i class="bi bi-calendar-range"></i></span>
        <h2 id="client-request-milestones"><%= t("client_requests.milestones_title") %></h2>
      </div>
      <ol class="rc-record-list wa-client-request__milestones">
        <% @milestones.each do |milestone| %>
          <li class="rc-record">
            <strong><%= milestone.title %></strong>
            <p class="rc-muted mb-0"><time datetime="<%= milestone.start_on.iso8601 %>"><%= milestone.start_on %></time> – <time datetime="<%= milestone.end_on.iso8601 %>"><%= milestone.end_on %></time> · <%= t("client_requests.tentative") %></p>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>
</div>
