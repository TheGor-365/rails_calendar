<%# An owner/admin calendar action menu; all destinations are existing guarded routes. %>
<% if admin_signed_in? %>
  <div class="wa-calendar-create-menu">
    <details class="wa-calendar-create-menu__details">
      <summary class="rc-action rc-action--primary" aria-label="<%= t("calendar_actions.create") %>">
        <%= rc_icon_label("plus-circle", t("calendar_actions.create")) %>
        <i class="bi bi-chevron-down" aria-hidden="true"></i>
      </summary>
      <div class="wa-calendar-create-menu__items">
        <button type="button" data-action="click->wa-calendar-create#open"
                data-start-at="<%= start_at.iso8601 %>"><%= rc_icon_label("calendar2-plus", t("calendar_actions.consultation")) %></button>
        <% if owner_signed_in? %>
          <%= link_to rc_icon_label("send-plus", t("calendar_actions.invitation")), owner_invitations_path %>
          <%= link_to rc_icon_label("journal-plus", t("calendar_actions.request")), new_project_intake_path %>
          <%= link_to rc_icon_label("collection", t("calendar_actions.library")), owner_artifacts_path %>
          <div class="wa-calendar-create-menu__divider"></div>
          <%= link_to rc_icon_label("stars", t("calendar_actions.with_ai")), owner_ai_assistant_path, class: "wa-calendar-create-menu__ai" %>
        <% end %>
      </div>
    </details>
  </div>
<% end %>
