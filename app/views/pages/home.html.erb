<div class="container my-4 my-sm-5">
  <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-3">
    <div>
      <p class="eyebrow mb-2">Overview</p>
      <h1 class="page-title mb-1">Consultations</h1>
      <p class="text-muted mb-0">Browse scheduled consultations. Times are shown in <%= Time.zone.name %>.</p>
    </div>
    <% if admin_signed_in? %>
      <%= link_to "New consultation", new_consultation_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <%= month_calendar(events: @consultations) do |date, consultations| %>
    <time class="calendar-day-label" datetime="<%= date.iso8601 %>"
          aria-label="<%= date.strftime('%A, %B %d, %Y') %>"><%= date.day %></time>

    <% consultations.each do |consultation| %>
      <article class="card calendar-event mt-2">
        <div class="card-body p-2">
          <h2 class="h6 mb-1">
            <%= link_to consultation.title, consultation, class: "stretched-link" %>
          </h2>
          <% if consultation.start_time.present? %>
            <time class="small text-muted" datetime="<%= consultation.start_time.iso8601 %>">
              <%= consultation.start_time.in_time_zone.strftime('%H:%M') %>
            </time>
          <% end %>
          <% if consultation.description.present? %>
            <p class="small mb-0 mt-1 text-break"><%= truncate(consultation.description, length: 110) %></p>
          <% end %>
        </div>
      </article>
    <% end %>
  <% end %>
</div>
