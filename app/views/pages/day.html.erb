<div class="container my-4 my-sm-5">
  <header class="rc-page-hero mb-4">
    <div>
      <p class="eyebrow mb-2"><%= t("calendar.day_eyebrow", day_number: @selected_date.strftime("%j")) %></p>
      <div class="rc-page-hero__heading"><span class="rc-page-hero__symbol" aria-hidden="true"><i class="bi bi-calendar-day"></i></span><h1 class="page-title mb-1">
        <time datetime="<%= @selected_date.iso8601 %>"><%= rc_local_date(@selected_date, format: :rc_full) %></time>
      </h1></div>
      <p class="rc-muted mb-0">
        <span class="rc-data-number"><%= rc_count(@consultations.size, "calendar", "consultation") %></span>
        <span aria-hidden="true">·</span> 00:00–24:00
        <span aria-hidden="true">·</span> <%= Time.zone.name %>
      </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if admin_signed_in? %>
        <%= link_to rc_icon_label("plus-lg", t("calendar.new_consultation")), new_consultation_path(start_at: @hour_slots.first[:start_time].iso8601),
                    class: "rc-action rc-action--primary" %>
      <% end %>
      <%= link_to rc_icon_label("calendar3", t("calendar.month")), root_path(start_date: @selected_date.iso8601),
                  class: "rc-action rc-action--quiet" %>
    </div>
  </header>

  <nav aria-label="<%= t("calendar.day_nav_aria") %>" class="rc-day-navigation mb-3">
    <% if @selected_date > Date.new(Consultation::MIN_SCHEDULE_YEAR, 1, 1) %>
      <%= link_to rc_icon_label("chevron-left", t("calendar.previous_day")), calendar_day_path(date: @selected_date.prev_day.iso8601),
                  class: "rc-navigation-link" %>
    <% end %>
    <%= link_to rc_icon_label("calendar-check", t("calendar.today")), calendar_day_path(date: Time.zone.today.iso8601),
                class: "rc-navigation-link" %>
    <% if @selected_date < Date.new(Consultation::MAX_SCHEDULE_YEAR, 12, 31) %>
      <%= link_to rc_icon_label("chevron-right", t("calendar.next_day")), calendar_day_path(date: @selected_date.next_day.iso8601),
                  class: "rc-navigation-link" %>
    <% end %>
  </nav>

  <section class="rc-agenda" aria-label="<%= t("calendar.agenda_aria") %>">
    <div class="rc-agenda-legend" aria-hidden="true">
      <span><%= t("calendar.time_heading") %></span><span><%= t("calendar.event_heading") %></span>
    </div>

    <div class="rc-day-grid">
      <div class="rc-time-axis" aria-label="<%= t("calendar.hour_axis_aria") %>">
        <% @hour_slots.each do |slot| %>
          <div class="rc-time-axis-hour" id="hour-<%= format('%02d', slot[:hour]) %>">
            <%= link_to calendar_hour_path(date: @selected_date.iso8601, hour: slot[:hour]),
                        class: "rc-time-axis-link",
                        aria: { label: t("calendar.inspect_interval", range: "#{slot[:start_time].strftime('%H:%M')}–#{slot[:end_time].strftime('%H:%M')}") } do %>
              <time datetime="<%= slot[:start_time].iso8601 %>"><%= slot[:start_time].strftime("%H:%M") %></time>
            <% end %>
            <% if slot[:count].positive? %>
              <span class="rc-time-axis-count" aria-label="<%= rc_count(slot[:count], "calendar", "event") %>"><%= slot[:count] %></span>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="rc-day-scroll" role="region" tabindex="0"
           aria-label="<%= t("calendar.scroll_aria") %>">
        <div class="rc-day-canvas" style="--rc-max-lanes: <%= @timeline.max_lanes %>">
          <div class="rc-hour-bands" role="list" aria-label="<%= t("calendar.bands_aria") %>">
            <% @hour_slots.each do |slot| %>
              <% from_label = slot[:start_time].strftime("%H:%M") %>
              <% to_label = slot[:end_time].strftime("%H:%M") %>
              <%= link_to calendar_hour_path(date: @selected_date.iso8601, hour: slot[:hour]),
                          class: "rc-hour-band #{'rc-hour-band--busy' if slot[:count].positive?}",
                          role: "listitem",
                          aria: { label: t("calendar.inspect_interval_count", range: "#{from_label}–#{to_label}", events: rc_count(slot[:count], "calendar", "event")) },
                          title: t("calendar.inspect_interval", range: "#{from_label}–#{to_label}") do %>
                <span class="visually-hidden">
                  <%= from_label %>–<%= to_label %>, <%= rc_count(slot[:count], "calendar", "event") %>
                </span>
              <% end %>
            <% end %>
          </div>

          <div class="rc-event-layer" aria-label="<%= t("calendar.event_layer_aria") %>">
            <% @timeline.items.each do |item| %>
              <% event = item.consultation %>
              <% left = (item.lane * 100.0 / item.lanes).round(4) %>
              <% width = (100.0 / item.lanes).round(4) %>
              <% time_span = "#{rc_local_datetime(event.start_time, format: :rc_short_time)} – #{rc_local_datetime(event.end_time, format: :rc_short_time)}" %>
              <article class="rc-range-event" id="event-<%= event.id %>"
                       style="top: <%= item.start_px %>px; height: <%= item.height_px %>px; left: <%= left %>%; width: calc(<%= width %>% - 8px);"
                       data-event-id="<%= event.id %>" data-lane="<%= item.lane %>"
                       data-lanes="<%= item.lanes %>">
                <%= link_to consultation_path(event),
                            class: "rc-range-event-link",
                            aria: { label: "#{event.title}, #{time_span}. #{t("calendar.open_consultation")}" },
                            title: "#{event.title} — #{time_span}" do %>
                  <span class="rc-range-event-heading"><%= event.title %></span>
                  <span class="rc-range-event-clock">
                    <time datetime="<%= item.visible_start_at.iso8601 %>"><%= item.visible_start_label %></time>
                    <span aria-hidden="true">–</span>
                    <time datetime="<%= item.visible_end_at.iso8601 %>"><%= item.visible_end_label %></time>
                  </span>
                  <% if item.height_px >= 95 && event.description.present? %>
                    <span class="rc-range-event-summary"><%= truncate(event.description, length: 85) %></span>
                  <% end %>
                  <% if item.height_px >= 82 && (item.continues_from_previous_day || item.continues_into_next_day) %>
                    <span class="rc-range-event-continuation">
                      <%= item.continues_from_previous_day ? t("calendar.continues_from") : t("calendar.continues_into") %>
                    </span>
                  <% end %>
                <% end %>
                <span class="rc-range-event-exact-bar" aria-hidden="true"
                      style="top: <%= (item.real_start_px - item.start_px).round(2) %>px; height: <%= [item.real_height_px, 2].max.round(2) %>px"></span>
              </article>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <p class="rc-hint mt-3">
    <%= t("calendar.day_help", zone: Time.zone.name) %>
  </p>
</div>
