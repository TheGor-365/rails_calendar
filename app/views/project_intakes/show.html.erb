<div class="container wa-owner-intake my-4 my-sm-5">
  <header class="rc-page-hero mb-4">
    <div class="rc-page-hero__content">
    <p class="eyebrow"><%= t("intake.show_eyebrow", id: @intake.id) %></p>
    <div class="rc-page-hero__heading"><span class="rc-page-hero__symbol" aria-hidden="true"><i class="bi bi-kanban"></i></span><h1 class="page-title"><%= @intake.title %></h1></div>
    <div class="wa-owner-intake__meta" aria-label="<%= t("intake.owner_view.meta_label") %>">
      <span class="rc-status-pill rc-status-pill--muted"><i class="bi bi-grid-1x2" aria-hidden="true"></i><%= rc_intake_type(@intake.project_type) %></span>
      <span class="rc-status-pill"><i class="bi bi-circle-half" aria-hidden="true"></i><%= rc_intake_status(@intake.status) %></span>
      <% if @latest_spec.present? %>
        <span class="rc-status-pill rc-status-pill--muted"><i class="bi bi-file-earmark-text" aria-hidden="true"></i><%= t("intake.spec_eyebrow", version: @latest_spec.version) %></span>
      <% end %>
    </div>
    <p class="rc-hint"><%= t("intake.show_hint") %></p>
    <% if owner_signed_in? %>
      <% quiz_questions = Intake::QuizCatalog.for(@intake.project_type) %>
      <% quiz_saved = @intake.intake_answers.where(question_key: quiz_questions.map { |question| question.fetch(:key) }).count %>
      <% quiz_label = quiz_saved.zero? ? t("intake.quiz_start") : (quiz_saved < quiz_questions.size ? t("intake.quiz_resume") : t("intake.quiz_review")) %>
      <div class="rc-quiz-intake-entry">
        <%= link_to rc_icon_label("ui-checks-grid", quiz_label), project_intake_quiz_path(@intake), class: "rc-action rc-action--primary" %>
        <p class="rc-hint mb-0 mt-2"><%= t("intake.quiz_saved", saved: quiz_saved, total: quiz_questions.size) %></p>
      </div>
    <% end %>
    </div>
  </header>
  <% owner_nav_sections = [
    ["intake-current", "pin-angle", t("intake_context.current_title")],
    ["intake-workflow", "diagram-3", t("intake.workflow_show")],
    ["intake-brief", "card-text", t("intake.owner_view.brief")],
    ["intake-interview", "chat-left-text", t("intake.interview_title")]
  ] %>
  <% owner_nav_sections << ["intake-scope", "diagram-3", t("e2_scope.owner_title")] if @intake.latest_scope_revision %>
  <% owner_nav_sections << ["intake-review", "shield-lock", t("intake.admin_title")] if admin_signed_in? %>
  <% owner_nav_sections << ["intake-spec", "file-earmark-text", t("intake.spec_title")] if @latest_spec && (admin_signed_in? || @latest_spec.approved?) %>
  <% owner_nav_sections << ["private-project-calendar", "calendar-range", t("intake.calendar_title")] if @milestones.any? && (admin_signed_in? || @latest_spec&.approved?) %>
  <div class="wa-detail-shell" data-controller="wa-section-nav">
    <%= render "shared/white_atlas/intake_side_nav", sections: owner_nav_sections %>
    <div class="wa-detail-shell__main">
  <%= render "shared/white_atlas/intake_current_context",
             intake: @intake, latest_message: @latest_client_message,
             visible_spec: @latest_spec, message_total: @message_total, perspective: "owner" %>

  <% current_stage = @milestones.any? ? "plan" : (@latest_spec.present? ? "review" : "interview") %>
  <div id="intake-workflow">
  <%= render "shared/workflow", title: t("intake.workflow_show"), current: current_stage, steps: [ ["request", "clipboard2-plus", t("intake.step_request"), t("intake.step_request_desc")], ["interview", "chat-left-text", t("intake.step_interview"), t("intake.step_interview_desc")], ["review", "clipboard2-check", t("intake.step_review"), t("intake.step_review_desc")], ["plan", "calendar-range", t("intake.step_plan"), t("intake.step_plan_desc")] ] %>
  </div>
    <section class="surface-panel wa-owner-intake__panel mb-4" id="intake-brief"
           aria-labelledby="intake-brief-heading">
    <div class="wa-owner-intake__section-heading">
      <span class="wa-owner-intake__icon" aria-hidden="true"><i class="bi bi-card-text"></i></span>
      <div><h2 id="intake-brief-heading"><%= t("intake.owner_view.brief") %></h2>
      <p class="rc-hint mb-0"><%= t("intake.owner_view.brief_help") %></p></div>
    </div>
    <% if (invite = @intake.client_request_invitation) %>
      <p class="rc-status-pill rc-status-pill--muted"><%= t("e2.state_#{invite.state}") %></p>
      <details class="wa-context__original mb-3">
        <summary><%= t("e2.owner_seed_title") %></summary>
        <p class="rc-hint"><%= t("e2.owner_seed_warning") %></p>
        <p class="wa-owner-intake__prose"><%= invite.seed_goal %></p>
        <% if invite.seed_goal != @intake.goal %>
          <p class="rc-hint"><%= t("e2.edit_title") %></p>
          <p class="wa-owner-intake__prose"><%= @intake.goal %></p>
        <% end %>
      </details>
    <% end %>
    <details class="wa-context__original" <%= "open" if @intake.goal.length <= 360 %>>
      <summary><i class="bi bi-journal-text" aria-hidden="true"></i><%= t("intake_context.original_toggle") %></summary>
      <div class="wa-owner-intake__brief">
        <p class="wa-owner-intake__prose"><%= @intake.goal %></p>
      </div>
    </details>
    <% if admin_signed_in? %>
      <% next_hint = if @milestones.any?
           t("intake.owner_view.next_milestones")
         elsif @latest_spec&.approved?
           t("intake.owner_view.next_published")
         elsif @latest_spec.present?
           t("intake.owner_view.next_draft")
         else
           t("intake.owner_view.next_interview")
         end %>
      <div class="wa-owner-intake__next">
        <i class="bi bi-signpost-split" aria-hidden="true"></i>
        <div><strong><%= t("intake.owner_view.next_heading") %></strong>
          <p class="mb-0"><%= next_hint %></p>
        </div>
      </div>
    <% end %>
  </section>
  <% if (scope_revision = @intake.latest_scope_revision) %>
    <section class="surface-panel wa-owner-intake__panel wa-scope-owner mb-4" id="intake-scope" aria-labelledby="intake-scope-heading">
      <div class="wa-owner-intake__section-heading">
        <span class="wa-owner-intake__icon" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
        <div>
          <h2 id="intake-scope-heading"><%= t("e2_scope.owner_title") %></h2>
          <p class="rc-hint mb-0"><%= t("e2_scope.owner_hint", version: scope_revision.version) %></p>
        </div>
      </div>
      <div class="wa-scope-owner__grid">
        <% IntakeScopeSections::ITEMS.each_with_index do |(key, icon), index| %>
          <% answer = scope_revision.answers.fetch(key, {}) %>
          <article class="wa-scope-owner__item">
            <div class="wa-scope-owner__item-top">
              <span class="wa-scope__section-icon"><i class="bi <%= icon %>" aria-hidden="true"></i></span>
              <div>
                <small><%= format("S-%02d", index + 1) %> <%= t("e2_scope.section_reference") %></small>
                <h3><%= t("e2_scope.sections.#{key}.title") %></h3>
              </div>
            </div>
            <p class="wa-scope-owner__technical"><%= t("e2_scope.sections.#{key}.technical") %></p>
            <p class="wa-scope-owner__client"><span><%= t("e2_scope.owner_client_says") %></span>
              <%= answer.fetch("text", "").presence || t("e2_scope.not_yet_answered") %></p>
            <div class="wa-scope-owner__meta">
              <span><%= t("e2_scope.statuses.#{answer.fetch("status", "unknown")}") %></span>
              <span><%= t("e2_scope.responsibilities.#{answer.fetch("responsibility", "open")}") %></span>
            </div>
          </article>
        <% end %>
      </div>
      <p class="rc-hint mt-3"><%= t("e2_scope.owner_warning") %></p>
    </section>
  <% end %>

  <section class="surface-panel wa-owner-intake__panel mb-4" id="intake-interview"
           aria-label="<%= t("intake.interview_aria") %>">
    <div class="wa-owner-intake__section-heading">
      <span class="wa-owner-intake__icon" aria-hidden="true"><i class="bi bi-chat-left-text"></i></span>
      <div><h2><%= t("intake.interview_title") %></h2>
        <p class="rc-hint mb-0"><%= t("intake.owner_view.messages_help") %></p>
      </div>
    </div>
    <div class="wa-owner-intake__thread" data-controller="wa-intake-thread">
      <details class="wa-context__history" <%= "open" if @messages.length <= 2 %>>
      <summary><i class="bi bi-clock-history" aria-hidden="true"></i><%= t("intake_context.history_toggle", count: @message_total) %></summary>
      <p class="rc-hint"><%= t("intake_context.history_window", count: @messages.size, total: @message_total) %></p>
      <div class="wa-context__history-tools">
      <div class="wa-owner-intake__filters" role="group" aria-label="<%= t("intake.owner_view.filter_label") %>">
        <% [["all", t("intake.owner_view.filter_all")], ["client", t("intake.role_client")], ["assistant", t("intake.role_assistant")]].each do |role, label| %>
          <button type="button" class="wa-owner-intake__filter"
                  data-wa-intake-thread-target="filter"
                  data-wa-intake-thread-role-param="<%= role %>"
                  data-action="click->wa-intake-thread#filter"
                  aria-pressed="<%= role == "all" %>"><%= label %></button>
        <% end %>
      </div>
      <label class="wa-context__search-label"><%= t("intake_context.search_label") %>
        <input type="search" class="wa-context__search"
               placeholder="<%= t("intake_context.search_placeholder") %>"
               data-wa-intake-thread-target="search" data-action="input->wa-intake-thread#search"/>
      </label>
      <label class="wa-context__sort-label"><%= t("intake_context.sort_label") %>
        <select class="wa-context__sort" data-wa-intake-thread-target="order"
                data-action="change->wa-intake-thread#sort">
          <option value="oldest"><%= t("intake_context.oldest_first") %></option>
          <option value="newest"><%= t("intake_context.newest_first") %></option>
        </select>
      </label>
      </div>
      <p class="wa-context__visible-count rc-hint" role="status" data-wa-intake-thread-target="count"></p>
      <ol class="rc-record-list wa-owner-intake__messages" id="intake-conversation"
          data-wa-intake-thread-target="list">
        <% @messages.each do |message| %>
          <li class="rc-record wa-owner-intake__message wa-owner-intake__message--<%= message.role %>"
              data-wa-intake-thread-target="item" data-wa-intake-thread-role="<%= message.role %>"
              data-wa-intake-thread-id="<%= message.id %>">
            <div class="wa-owner-intake__message-top">
              <strong><span class="wa-context__actor-icon wa-context__actor-icon--<%= message.role %>" aria-hidden="true"><i class="bi bi-<%= message.role == "client" ? "person-fill" : "robot" %>"></i></span>
                <%= message.role == "client" ? t("intake.role_client") : t("intake.role_assistant") %></strong>
              <time datetime="<%= message.created_at.iso8601 %>"><%= message.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %></time>
            </div>
            <p class="wa-owner-intake__prose mb-0"><%= message.body %></p>
          </li>
        <% end %>
      </ol>
      <p class="wa-owner-intake__filter-empty rc-hint" data-wa-intake-thread-target="empty" hidden role="status">
        <%= t("intake.owner_view.no_messages") %>
      </p>
      </details>
    </div>
    <% if @message_errors.present? %>
      <div class="rc-notice rc-notice--error" role="alert"><%= @message_errors.to_sentence %></div>
    <% end %>
    <% if @intake.client_user_id.present? %>
      <p class="rc-hint wa-context__owner-reply-note"><i class="bi bi-shield-check" aria-hidden="true"></i><%= t("intake_context.owner_reply_not_available") %></p>
    <% elsif @intake.status == "interviewing" && @intake.client_message_count < ProjectIntake::MAX_CLIENT_MESSAGES %>
      <%= form_with url: reply_project_intake_path(@intake), method: :post, html: { class: "rc-form mt-3" } do |f| %>
        <div class="rc-field mb-2">
          <%= f.label :answer, t("intake.answer"), class: "rc-field-label" %>
          <%= f.text_area :answer, class: "rc-input rc-input--area", maxlength: 1200, required: true, rows: 3, data: { controller: "wa-autogrow", action: "input->wa-autogrow#resize" } %>
        </div>
        <%= f.button type: :submit, class: "rc-action rc-action--primary" do %><%= rc_icon_label("send", t("intake.send_answer")) %><% end %>
      <% end %>
    <% else %>
      <p class="rc-hint"><%= t("intake.interview_paused") %></p>
    <% end %>
  </section>

  <% if admin_signed_in? %>
    <section class="surface-panel wa-owner-intake__panel mb-4" id="intake-review"
             aria-label="<%= t("intake.admin_aria") %>">
      <div class="wa-owner-intake__section-heading">
        <span class="wa-owner-intake__icon" aria-hidden="true"><i class="bi bi-shield-lock"></i></span>
        <div><h2><%= t("intake.admin_title") %></h2><p class="rc-hint mb-0"><%= t("intake.admin_hint") %></p></div>
      </div>
      <% if @intake.client_message_count.positive? %>
        <%= button_to rc_icon_label("stars", t("intake.generate_spec")),
            draft_spec_admin_project_intake_path(@intake), method: :post,
            class: "rc-action rc-action--primary" %>
      <% end %>
      <% if @latest_spec && @intake.status == "draft_spec" %>
        <%= link_to rc_icon_label("pencil-square", t("intake.edit_spec")),
            edit_spec_admin_project_intake_path(@intake), class: "rc-action rc-action--quiet mt-3" %>
        <%= button_to rc_icon_label("check2-circle", t("intake.approve_spec")),
            approve_spec_admin_project_intake_path(@intake), method: :post,
            class: "rc-action rc-action--quiet mt-3" %>
      <% end %>
      <%= link_to rc_icon_label("inboxes", t("intake.all_drafts")), admin_project_intakes_path, class: "rc-action rc-action--soft rc-action--small" %>
    </section>
  <% end %>

  <% if @latest_spec && (admin_signed_in? || @latest_spec.approved?) %>
    <section class="surface-panel wa-owner-intake__panel mb-4" id="intake-spec" aria-label="<%= t("intake.spec_aria") %>">
      <p class="eyebrow"><%= t("intake.spec_eyebrow", version: @latest_spec.version) %></p>
      <div class="wa-owner-intake__section-heading">
        <span class="wa-owner-intake__icon" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></span>
        <div><h2><%= t("intake.spec_title") %></h2>
          <p class="rc-hint mb-0"><%= t("intake.generated_source", source: { "grok" => "Grok", "human" => t("intake.source_human") }.fetch(@latest_spec.source, t("intake.source_template"))) %></p>
        </div>
      </div>
      <p class="wa-owner-intake__spec-state"><i class="bi bi-<%= @latest_spec.approved? ? "check2-circle" : "lock" %>" aria-hidden="true"></i>
        <%= @latest_spec.approved? ? t("intake.spec_approved") : t("intake.spec_private") %>
        <span class="rc-status-pill rc-status-pill--muted"><%= t("intake.spec_eyebrow", version: @latest_spec.version) %></span>
      </p>
      <p class="wa-owner-intake__prose wa-owner-intake__summary"><%= @latest_spec.document["summary"] %></p>
      <div class="wa-owner-intake__spec-grid">
        <% [
          ["goals", "bullseye", "goals", t("intake.section_goals")],
          ["deliverables", "box-seam", "deliverables", t("intake.section_deliverables")],
          ["acceptance_criteria", "check2-square", "acceptance-criteria", t("intake.section_acceptance_criteria")],
          ["unknowns", "question-circle", "unknowns", t("intake.section_unknowns")],
          ["exclusions", "slash-circle", "exclusions", t("intake.section_exclusions")]
        ].each do |key, icon, kind, title| %>
          <%= render "shared/white_atlas/spec_section", id: "owner-spec-#{kind}", kind: kind,
                icon: icon, title: title, items: @latest_spec.document[key] %>
        <% end %>
      </div>
      <h3 class="h5 mt-4"><%= t("intake.milestone_title") %></h3>
      <ol>
        <% Array(@latest_spec.document["milestones"]).each do |phase| %>
          <li>
            <strong><%= phase["title"] %></strong> —
            <%= phase["description"] %>
            <span class="rc-hint">(<%= t("intake.suggested_days", count: phase["suggested_work_days"]) %>)</span>
          </li>
        <% end %>
      </ol>
      <% if admin_signed_in? && @latest_spec.approved? && @milestones.empty? %>
        <div class="surface-panel p-3 mt-4" aria-label="<%= t("intake.plan_aria") %>">
          <h3 class="h5"><%= t("intake.plan_title") %></h3>
          <%= form_with url: plan_admin_project_intake_path(@intake), method: :post do |f| %>
            <%= label_tag :start_date, t("intake.plan_start"), class: "rc-field-label" %>
            <%= date_field_tag :start_date, Date.current.iso8601, min: "2000-01-01", max: "2100-12-31", class: "rc-input", required: true %>
            <%= hidden_field_tag :confirm_plan, "1" %>
            <p class="rc-hint"><%= t("intake.plan_help") %></p>
            <%= f.button type: :submit, class: "rc-action rc-action--primary mt-2" do %><%= rc_icon_label("calendar-range", t("intake.plan_create")) %><% end %>
          <% end %>
        </div>
      <% end %>
      <% if @latest_spec.approved? && @latest_spec.client_reviewed_at.nil? %>
        <%= button_to rc_icon_label("check2-circle", t("intake.mark_reviewed")), acknowledge_project_intake_path(@intake),
            method: :post, class: "rc-action rc-action--quiet" %>
      <% elsif @latest_spec.client_reviewed_at %>
        <p class="rc-notice rc-notice--neutral" role="status"><%= t("intake.reviewed_note") %></p>
      <% end %>
    </section>
  <% end %>

  <% if @milestones.any? && (admin_signed_in? || @latest_spec&.approved?) %>
    <section class="surface-panel wa-owner-intake__panel mt-4" aria-label="<%= t("intake.calendar_aria") %>" id="private-project-calendar">
      <p class="eyebrow"><%= t("intake.calendar_eyebrow") %></p>
      <h2 class="h4"><i class="bi bi-calendar-range me-2" aria-hidden="true"></i><%= t("intake.calendar_title") %></h2>
      <p class="rc-hint"><%= t("intake.calendar_hint") %></p>
      <ol class="rc-record-list">
        <% @milestones.each do |milestone| %>
          <li class="rc-record">
            <strong><%= milestone.title %></strong>
            <p><%= milestone.description %></p>
            <p class="rc-muted"><time datetime="<%= milestone.start_on.iso8601 %>"><%= milestone.start_on.iso8601 %></time> –
              <time datetime="<%= milestone.end_on.iso8601 %>"><%= milestone.end_on.iso8601 %></time> (<%= t("intake.dates_proposed") %>)</p>
          </li>
        <% end %>
      </ol>
      <div class="rc-calendar-container" id="intake-month-grid">
        <%= month_calendar(start_date: @visible_month) do |date| %>
          <span class="rc-muted"><%= date.day %></span>
          <% @milestones.each do |milestone| %>
            <% if (milestone.start_on..milestone.end_on).cover?(date) && !date.saturday? && !date.sunday? %>
              <div class="rc-hint"><%= milestone.title %></div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
    </div>
  </div>
</div>
