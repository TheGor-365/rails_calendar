<div class="container my-4 my-sm-5">
  <header class="mb-4">
    <p class="eyebrow">AI SERVICE WORKSPACE / INTAKE #<%= @intake.id %></p>
    <h1 class="page-title"><%= @intake.title %></h1>
    <p class="rc-muted">Status: <%= @intake.status.humanize %> · Category: <%= @intake.project_type.humanize %></p>
    <p class="rc-hint">Proposals and dates remain tentative. Demo browser sessions are not verified client identities.</p>
  </header>
  <section class="surface-panel p-3 p-sm-4 mb-4" aria-label="Client interview">
    <h2 class="h4">Clarifying interview</h2>
    <p class="rc-muted"><%= @intake.goal %></p>
    <ol class="rc-record-list" id="intake-conversation">
      <% @messages.each do |message| %>
        <li class="rc-record">
          <strong><%= message.role == "client" ? "Client (demo)" : "Intake assistant" %></strong>
          <p class="mb-0"><%= message.body %></p>
        </li>
      <% end %>
    </ol>
    <% if @message_errors.present? %>
      <div class="rc-notice rc-notice--error" role="alert"><%= @message_errors.to_sentence %></div>
    <% end %>
    <% if @intake.status == "interviewing" && @intake.client_message_count < ProjectIntake::MAX_CLIENT_MESSAGES %>
      <%= form_with url: reply_project_intake_path(@intake), method: :post, html: { class: "rc-form mt-3" } do |f| %>
        <div class="rc-field mb-2">
          <%= f.label :answer, "Your answer", class: "rc-field-label" %>
          <%= f.text_area :answer, class: "rc-input", maxlength: 1200, required: true, rows: 3 %>
        </div>
        <%= f.submit "Send answer", class: "rc-action rc-action--primary" %>
      <% end %>
    <% else %>
      <p class="rc-hint">Interview paused. An administrator can review or generate the next version of the specification.</p>
    <% end %>
  </section>

  <% if admin_signed_in? %>
    <section class="surface-panel p-3 p-sm-4 mb-4" aria-label="Administrator review">
      <h2 class="h4">Administrator controls</h2>
      <p>AI produces only a draft. Inspect the unknowns and acceptance criteria before approving a version.</p>
      <% if @intake.client_message_count.positive? %>
        <%= button_to "Generate a new specification draft",
            draft_spec_admin_project_intake_path(@intake), method: :post,
            class: "rc-action rc-action--primary" %>
      <% end %>
      <% if @latest_spec && @intake.status == "draft_spec" %>
        <%= link_to "Edit specification and create a human-reviewed revision",
            edit_spec_admin_project_intake_path(@intake), class: "rc-action rc-action--quiet mt-3" %>
        <%= button_to "Approve this draft for demo client review",
            approve_spec_admin_project_intake_path(@intake), method: :post,
            class: "rc-action rc-action--quiet mt-3" %>
      <% end %>
      <%= link_to "All intake drafts", admin_project_intakes_path, class: "rc-text-link" %>
    </section>
  <% end %>

  <% if @latest_spec && (admin_signed_in? || @latest_spec.approved?) %>
    <section class="surface-panel p-3 p-sm-4" aria-label="Technical specification">
      <p class="eyebrow">SPECIFICATION / VERSION <%= @latest_spec.version %></p>
      <h2 class="h4">Draft technical specification</h2>
      <p class="rc-hint">Generated by <%= { "grok" => "Grok", "human" => "administrator revision" }.fetch(@latest_spec.source, "a local demo template") %>.
        <%= @latest_spec.approved? ? "Admin-reviewed version." : "Internal draft — not shared with demo clients." %></p>
      <p><%= @latest_spec.document["summary"] %></p>
      <% { "goals" => "Objectives", "deliverables" => "Deliverables",
           "acceptance_criteria" => "Acceptance criteria",
           "unknowns" => "Unknowns to confirm", "exclusions" => "Out of scope" }.each do |key, title| %>
        <h3 class="h5 mt-4"><%= title %></h3>
        <ul><% Array(@latest_spec.document[key]).each do |line| %><li><%= line %></li><% end %></ul>
      <% end %>
      <h3 class="h5 mt-4">Suggested project phases — not booked calendar dates</h3>
      <ol>
        <% Array(@latest_spec.document["milestones"]).each do |phase| %>
          <li>
            <strong><%= phase["title"] %></strong> —
            <%= phase["description"] %>
            <span class="rc-hint">(<%= phase["suggested_work_days"] %> suggested workdays; unapproved)</span>
          </li>
        <% end %>
      </ol>
      <% if @latest_spec.approved? && @latest_spec.client_reviewed_at.nil? %>
        <%= button_to "Mark version as reviewed (demo only)", acknowledge_project_intake_path(@intake),
            method: :post, class: "rc-action rc-action--quiet" %>
      <% elsif @latest_spec.client_reviewed_at %>
        <p class="rc-notice rc-notice--neutral" role="status">Demo client marked this version as reviewed. This is not a signed acceptance or payment.</p>
      <% end %>
    </section>
  <% end %>
</div>
