<div class="container my-4 my-sm-5">
  <header class="rc-page-hero mb-4">
    <div class="rc-page-hero__content">
    <p class="eyebrow"><%= t("intake.show_eyebrow", id: @intake.id) %></p>
    <div class="rc-page-hero__heading"><span class="rc-page-hero__symbol" aria-hidden="true"><i class="bi bi-kanban"></i></span><h1 class="page-title"><%= @intake.title %></h1></div>
    <p class="rc-muted"><%= t("intake.show_status", status: rc_intake_status(@intake.status), category: rc_intake_type(@intake.project_type)) %></p>
    <p class="rc-hint"><%= t("intake.show_hint") %></p>
    <% if owner_signed_in? %>
      <% quiz_questions = Intake::QuizCatalog.for(@intake.project_type) %>
      <% quiz_saved = @intake.intake_answers.where(question_key: quiz_questions.map { |question| question.fetch(:key) }).count %>
      <% quiz_label = quiz_saved.zero? ? t("intake.quiz_start") : (quiz_saved < quiz_questions.size ? t("intake.quiz_resume") : t("intake.quiz_review")) %>
      <div class="rc-quiz-intake-entry">
        <%= link_to rc_icon_label("ui-checks-grid", quiz_label), project_intake_quiz_path(@intake), class: "rc-action rc-action--primary" %>
        <p class="rc-hint mb-0 mt-2"><%= t("intake.quiz_saved", saved: quiz_saved, total: quiz_questions.size) %></p>
      </div>
    <% end %>
    </div>
  </header>
  <% current_stage = @milestones.any? ? "plan" : (@latest_spec.present? ? "review" : "interview") %>
  <%= render "shared/workflow", title: t("intake.workflow_show"), current: current_stage, steps: [ ["request", "clipboard2-plus", t("intake.step_request"), t("intake.step_request_desc")], ["interview", "chat-left-text", t("intake.step_interview"), t("intake.step_interview_desc")], ["review", "clipboard2-check", t("intake.step_review"), t("intake.step_review_desc")], ["plan", "calendar-range", t("intake.step_plan"), t("intake.step_plan_desc")] ] %>
  <section class="surface-panel p-3 p-sm-4 mb-4" aria-label="<%= t("intake.interview_aria") %>">
    <h2 class="h4"><i class="bi bi-chat-left-text me-2" aria-hidden="true"></i><%= t("intake.interview_title") %></h2>
    <p class="rc-muted"><%= @intake.goal %></p>
    <ol class="rc-record-list" id="intake-conversation">
      <% @messages.each do |message| %>
        <li class="rc-record">
          <strong><%= message.role == "client" ? t("intake.role_client") : t("intake.role_assistant") %></strong>
          <p class="mb-0"><%= message.body %></p>
        </li>
      <% end %>
    </ol>
    <% if @message_errors.present? %>
      <div class="rc-notice rc-notice--error" role="alert"><%= @message_errors.to_sentence %></div>
    <% end %>
    <% if @intake.status == "interviewing" && @intake.client_message_count < ProjectIntake::MAX_CLIENT_MESSAGES %>
      <%= form_with url: reply_project_intake_path(@intake), method: :post, html: { class: "rc-form mt-3" } do |f| %>
        <div class="rc-field mb-2">
          <%= f.label :answer, t("intake.answer"), class: "rc-field-label" %>
          <%= f.text_area :answer, class: "rc-input", maxlength: 1200, required: true, rows: 3 %>
        </div>
        <%= f.button type: :submit, class: "rc-action rc-action--primary" do %><%= rc_icon_label("send", t("intake.send_answer")) %><% end %>
      <% end %>
    <% else %>
      <p class="rc-hint"><%= t("intake.interview_paused") %></p>
    <% end %>
  </section>

  <% if admin_signed_in? %>
    <section class="surface-panel p-3 p-sm-4 mb-4" aria-label="<%= t("intake.admin_aria") %>">
      <h2 class="h4"><i class="bi bi-shield-lock me-2" aria-hidden="true"></i><%= t("intake.admin_title") %></h2>
      <p><%= t("intake.admin_hint") %></p>
      <% if @intake.client_message_count.positive? %>
        <%= button_to rc_icon_label("stars", t("intake.generate_spec")),
            draft_spec_admin_project_intake_path(@intake), method: :post,
            class: "rc-action rc-action--primary" %>
      <% end %>
      <% if @latest_spec && @intake.status == "draft_spec" %>
        <%= link_to rc_icon_label("pencil-square", t("intake.edit_spec")),
            edit_spec_admin_project_intake_path(@intake), class: "rc-action rc-action--quiet mt-3" %>
        <%= button_to rc_icon_label("check2-circle", t("intake.approve_spec")),
            approve_spec_admin_project_intake_path(@intake), method: :post,
            class: "rc-action rc-action--quiet mt-3" %>
      <% end %>
      <%= link_to rc_icon_label("inboxes", t("intake.all_drafts")), admin_project_intakes_path, class: "rc-action rc-action--soft rc-action--small" %>
    </section>
  <% end %>

  <% if @latest_spec && (admin_signed_in? || @latest_spec.approved?) %>
    <section class="surface-panel p-3 p-sm-4" aria-label="<%= t("intake.spec_aria") %>">
      <p class="eyebrow"><%= t("intake.spec_eyebrow", version: @latest_spec.version) %></p>
      <h2 class="h4"><i class="bi bi-file-earmark-text me-2" aria-hidden="true"></i><%= t("intake.spec_title") %></h2>
      <p class="rc-hint"><%= t("intake.generated_source", source: { "grok" => "Grok", "human" => t("intake.source_human") }.fetch(@latest_spec.source, t("intake.source_template"))) %>
        <%= @latest_spec.approved? ? t("intake.spec_approved") : t("intake.spec_private") %></p>
      <p><%= @latest_spec.document["summary"] %></p>
      <% { "goals" => t("intake.section_goals"), "deliverables" => t("intake.section_deliverables"),
           "acceptance_criteria" => t("intake.section_acceptance_criteria"),
           "unknowns" => t("intake.section_unknowns"), "exclusions" => t("intake.section_exclusions") }.each do |key, title| %>
        <h3 class="h5 mt-4"><%= title %></h3>
        <ul><% Array(@latest_spec.document[key]).each do |line| %><li><%= line %></li><% end %></ul>
      <% end %>
      <h3 class="h5 mt-4"><%= t("intake.milestone_title") %></h3>
      <ol>
        <% Array(@latest_spec.document["milestones"]).each do |phase| %>
          <li>
            <strong><%= phase["title"] %></strong> —
            <%= phase["description"] %>
            <span class="rc-hint">(<%= t("intake.suggested_days", count: phase["suggested_work_days"]) %>)</span>
          </li>
        <% end %>
      </ol>
      <% if admin_signed_in? && @latest_spec.approved? && @milestones.empty? %>
        <div class="surface-panel p-3 mt-4" aria-label="<%= t("intake.plan_aria") %>">
          <h3 class="h5"><%= t("intake.plan_title") %></h3>
          <%= form_with url: plan_admin_project_intake_path(@intake), method: :post do |f| %>
            <%= label_tag :start_date, t("intake.plan_start"), class: "rc-field-label" %>
            <%= date_field_tag :start_date, Date.current.iso8601, min: "2000-01-01", max: "2100-12-31", class: "rc-input", required: true %>
            <%= hidden_field_tag :confirm_plan, "1" %>
            <p class="rc-hint"><%= t("intake.plan_help") %></p>
            <%= f.button type: :submit, class: "rc-action rc-action--primary mt-2" do %><%= rc_icon_label("calendar-range", t("intake.plan_create")) %><% end %>
          <% end %>
        </div>
      <% end %>
      <% if @latest_spec.approved? && @latest_spec.client_reviewed_at.nil? %>
        <%= button_to rc_icon_label("check2-circle", t("intake.mark_reviewed")), acknowledge_project_intake_path(@intake),
            method: :post, class: "rc-action rc-action--quiet" %>
      <% elsif @latest_spec.client_reviewed_at %>
        <p class="rc-notice rc-notice--neutral" role="status"><%= t("intake.reviewed_note") %></p>
      <% end %>
    </section>
  <% end %>

  <% if @milestones.any? && (admin_signed_in? || @latest_spec&.approved?) %>
    <section class="surface-panel p-3 p-sm-4 mt-4" aria-label="<%= t("intake.calendar_aria") %>" id="private-project-calendar">
      <p class="eyebrow"><%= t("intake.calendar_eyebrow") %></p>
      <h2 class="h4"><i class="bi bi-calendar-range me-2" aria-hidden="true"></i><%= t("intake.calendar_title") %></h2>
      <p class="rc-hint"><%= t("intake.calendar_hint") %></p>
      <ol class="rc-record-list">
        <% @milestones.each do |milestone| %>
          <li class="rc-record">
            <strong><%= milestone.title %></strong>
            <p><%= milestone.description %></p>
            <p class="rc-muted"><time datetime="<%= milestone.start_on.iso8601 %>"><%= milestone.start_on.iso8601 %></time> –
              <time datetime="<%= milestone.end_on.iso8601 %>"><%= milestone.end_on.iso8601 %></time> (<%= t("intake.dates_proposed") %>)</p>
          </li>
        <% end %>
      </ol>
      <div class="rc-calendar-container" id="intake-month-grid">
        <%= month_calendar(start_date: @visible_month) do |date| %>
          <span class="rc-muted"><%= date.day %></span>
          <% @milestones.each do |milestone| %>
            <% if (milestone.start_on..milestone.end_on).cover?(date) && !date.saturday? && !date.sunday? %>
              <div class="rc-hint"><%= milestone.title %></div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
