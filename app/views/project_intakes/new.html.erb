<div class="container my-4 my-sm-5">
  <header class="rc-page-hero mb-4">
    <div class="rc-page-hero__content">
    <p class="eyebrow"><%= t("intake.new_eyebrow") %></p>
    <div class="rc-page-hero__heading"><span class="rc-page-hero__symbol" aria-hidden="true"><i class="bi bi-clipboard2-plus"></i></span><h1 class="page-title"><%= t("intake.new_title") %></h1></div>
    <p class="rc-muted"><%= t("intake.new_hint") %></p>
    </div>
  </header>
  <%= render "shared/workflow", title: t("intake.workflow_new"), current: "request", steps: [ ["request", "clipboard2-plus", t("intake.step_request"), t("intake.step_request_desc")], ["interview", "chat-left-text", t("intake.step_interview"), t("intake.step_interview_desc")], ["review", "clipboard2-check", t("intake.step_review"), t("intake.step_review_desc")], ["plan", "calendar-range", t("intake.step_plan"), t("intake.step_plan_desc")] ] %>
  <div class="surface-panel p-4">
    <% if @intake.errors.any? %>
      <div class="rc-notice rc-notice--error" role="alert"><%= @intake.errors.full_messages.to_sentence %></div>
    <% end %>
    <%= form_with model: @intake, html: { class: "rc-form" } do |f| %>
      <div class="rc-field mb-3">
        <%= f.label :title, t("intake.field_title"), class: "rc-field-label" %>
        <%= f.text_field :title, class: "rc-input", required: true, maxlength: 120, placeholder: t("intake.example_title") %>
      </div>
      <div class="rc-field mb-3">
        <%= f.label :project_type, t("intake.field_type"), class: "rc-field-label" %>
        <%= f.select :project_type,
            [[rc_intake_type("website"), "website"], [rc_intake_type("redesign"), "redesign"],
             [rc_intake_type("rails_bugfix"), "rails_bugfix"], [rc_intake_type("api_integration"), "api_integration"]],
            { include_blank: t("intake.type_blank") }, class: "rc-input", required: true %>
      </div>
      <div class="rc-field mb-3">
        <%= f.label :goal, t("intake.field_goal"), class: "rc-field-label" %>
        <%= f.text_area :goal, class: "rc-input", rows: 5, required: true, minlength: 10, maxlength: 3000,
            placeholder: t("intake.example_goal") %>
      </div>
      <div class="rc-field mb-3">
        <%= check_box_tag :demo_consent, "1", false, required: true %>
        <%= label_tag :demo_consent, t("intake.demo_consent") %>
      </div>
      <p class="rc-hint"><%= t("intake.demo_warning") %></p>
      <%= f.button type: :submit, class: "rc-action rc-action--primary" do %><%= rc_icon_label("arrow-right-circle", t("intake.start_intake")) %><% end %>
    <% end %>
  </div>
</div>
