<div class="container my-4 my-sm-5 wa-invite-page">
  <header class="ws-owner-hero wa-invite-hero mb-4"><div class="rc-page-hero__content">
    <p class="eyebrow"><%= t("e2.owner_eyebrow") %></p>
    <div class="rc-page-hero__heading"><span class="rc-page-hero__symbol" aria-hidden="true"><i class="bi bi-send"></i></span>
      <h1 class="page-title"><%= t("e2.owner_title") %></h1></div>
    <p class="rc-muted"><%= t("e2.owner_hint") %></p>
    <div class="wa-invite-hero__notes">
      <span><i class="bi bi-shield-lock" aria-hidden="true"></i> <%= t("e2.demo_warning") %></span>
      <span><i class="bi bi-clock-history" aria-hidden="true"></i> <%= t("e2.copy_once") %></span>
    </div>
  </div>
  <span class="wa-invite-hero__decoration" aria-hidden="true"><i class="bi bi-send-check"></i></span>
  </header>

  <% if (url = flash[:issued_invitation_url]).present? %>
    <section class="surface-panel p-3 p-sm-4 mb-4 wa-invite-copy" aria-label="<%= t('e2.copy_title') %>">
      <h2 class="h5"><%= t("e2.copy_title") %></h2>
      <p class="rc-hint"><%= t("e2.copy_once") %></p>
      <div data-controller="wa-copy">
        <label for="e2-invite-link" class="rc-field-label"><%= t("e2.link_label") %></label>
        <input id="e2-invite-link" type="url" class="rc-input mb-2" readonly
               value="<%= url %>" data-wa-copy-target="input" />
        <button type="button" class="rc-action rc-action--primary" data-action="click->wa-copy#copy">
          <%= rc_icon_label("clipboard", t("e2.copy_action")) %>
        </button>
        <span class="rc-hint" data-wa-copy-target="status" role="status"></span>
      </div>
    </section>
  <% end %>

  <section class="surface-panel p-3 p-sm-4 mb-4 wa-invite-compose">
    <div class="wa-invite-section-heading">
      <span class="wa-invite-section-icon" aria-hidden="true"><i class="bi bi-pencil-square"></i></span>
      <div>
        <p class="eyebrow">01 / DRAFT</p>
        <h2 class="h5"><%= t("e2.new_title") %></h2>
        <p class="rc-hint"><%= t("e2.demo_warning") %></p>
      </div>
    </div>
    <% if @invitation&.errors&.any? %>
      <p class="rc-notice rc-notice--error" role="alert"><%= @invitation.errors.full_messages.to_sentence %></p>
    <% end %>
    <%= form_with url: owner_invitations_path, method: :post, html: {
      class: "rc-form wa-invite-form",
      data: {
        controller: "wa-invitation-brief",
        wa_invitation_brief_minimum_value: 10, wa_invitation_brief_maximum_value: 1200,
        wa_brief_client_decides: t("e2_builder.client_decides"),
        wa_brief_owner_decides: t("e2_builder.owner_decides"),
        wa_brief_notes_label: t("e2_builder.notes"),
        wa_brief_keep_manual: t("e2_builder.keep_manual"),
        wa_brief_empty: t("e2_builder.empty"),
        wa_brief_long: t("e2_builder.long"),
        wa_brief_composed: t("e2_builder.composed")
      }
    } do %>
      <div class="wa-invite-brief-grid">
      <div class="rc-field mb-3">
        <%= label_tag "proposal_seed_title", t("e2.seed_title"), class: "rc-field-label" %>
        <%= text_field_tag "proposal[seed_title]", @invitation&.seed_title, id: "proposal_seed_title",
              class: "rc-input", maxlength: 120, required: true %>
      </div>
      <div class="rc-field mb-3">
        <%= label_tag "proposal_seed_project_type", t("e2.seed_type"), class: "rc-field-label" %>
        <%= select_tag "proposal[seed_project_type]",
              options_for_select(ProjectIntake::TYPES.map { |type| [rc_intake_type(type), type] },
                                 @invitation&.seed_project_type),
              id: "proposal_seed_project_type", class: "rc-input" %>
      </div>
      </div>
      <section class="wa-invite-builder" aria-labelledby="wa-invite-builder-heading">
        <div class="wa-invite-field-heading">
          <span class="wa-invite-section-icon" aria-hidden="true"><i class="bi bi-ui-checks-grid"></i></span>
          <div>
            <h3 id="wa-invite-builder-heading"><%= t("e2_builder.title") %></h3>
            <p class="rc-hint"><%= t("e2_builder.hint") %></p>
          </div>
        </div>
        <% InvitationBriefTaxonomy.sections.each do |group, options| %>
          <details class="wa-invite-builder__group" <%= "open" if group == "tasks" %>>
            <summary><i class="bi <%= InvitationBriefTaxonomy::ICONS.fetch(group) %>" aria-hidden="true"></i> <%= t("e2_builder.sections.#{group}") %> <i class="bi bi-chevron-down wa-invite-builder__chevron" aria-hidden="true"></i></summary>
            <fieldset data-wa-brief-section>
              <legend><%= t("e2_builder.sections.#{group}") %></legend>
              <div class="wa-invite-builder__choices">
                <% options.each do |option| %>
                  <label class="wa-invite-builder__choice">
                    <input type="checkbox" value="<%= option %>" data-wa-brief-choice>
                    <span><%= t("e2_builder.options.#{option}") %></span>
                  </label>
                <% end %>
              </div>
              <label class="wa-invite-builder__decision">
                <span><%= t("e2_builder.decision_label") %></span>
                <select class="rc-input" data-wa-brief-decision>
                  <option value="skip"><%= t("e2_builder.skip") %></option>
                  <option value="client"><%= t("e2_builder.client_decides") %></option>
                  <option value="owner"><%= t("e2_builder.owner_decides") %></option>
                </select>
              </label>
            </fieldset>
          </details>
        <% end %>
        <label class="rc-field-label" for="wa-invite-builder-notes"><%= t("e2_builder.notes") %></label>
        <textarea id="wa-invite-builder-notes" rows="2" maxlength="350" class="rc-input rc-input--area"
                  data-wa-invitation-brief-target="notes"></textarea>
        <div class="wa-invite-builder__actions">
          <button type="button" class="rc-action rc-action--soft" data-action="click->wa-invitation-brief#compose">
            <%= rc_icon_label("magic", t("e2_builder.assemble")) %>
          </button>
          <p class="rc-hint" data-wa-invitation-brief-target="status" role="status" aria-live="polite"></p>
        </div>
      </section>
      <div class="rc-field mb-3 wa-invite-goal">
        <div class="wa-invite-field-heading">
          <span class="wa-invite-section-icon" aria-hidden="true"><i class="bi bi-card-text"></i></span>
          <div><strong><%= t("e2.seed_goal") %></strong><small><%= t("e2.owner_hint") %></small></div>
        </div>
        <%= label_tag "proposal_seed_goal", t("e2.seed_goal"), class: "rc-field-label" %>
        <%= text_area_tag "proposal[seed_goal]", @invitation&.seed_goal,
              id: "proposal_seed_goal", class: "rc-input rc-input--area", rows: 5,
              minlength: 10, maxlength: 1200, required: true,
              data: { controller: "wa-autogrow", action: "input->wa-autogrow#resize input->wa-invitation-brief#manualEdit", wa_invitation_brief_target: "goal" } %>
      </div>
      <fieldset class="rc-field mb-3 wa-invite-services">
        <legend class="rc-field-label"><i class="bi bi-grid-1x2" aria-hidden="true"></i> <%= t("e2.services") %></legend>
        <div class="wa-invite-service-grid">
        <% @offerings.each do |offering| %>
          <label class="wa-invite-service-choice">
            <%= check_box_tag "service_version_ids[]", offering.published_version_id,
                  @invitation&.service_version_ids&.include?(offering.published_version_id) || false %>
            <span class="wa-invite-service-choice__icon" aria-hidden="true"><i class="bi bi-check2-square"></i></span>
            <span><%= offering.published_version.title %></span>
          </label>
        <% end %>
        </div>
        <p class="rc-hint"><%= t("e2.services_hint") %></p>
      </fieldset>
      <div class="wa-invite-submit">
        <span class="rc-hint"><i class="bi bi-shield-check" aria-hidden="true"></i> <%= t("e2.copy_once") %></span>
        <button type="submit" class="rc-action rc-action--primary">
          <%= rc_icon_label("link-45deg", t("e2.issue_action")) %>
        </button>
      </div>
    <% end %>
  </section>

  <section class="surface-panel p-3 p-sm-4 wa-invite-history">
    <div class="wa-invite-section-heading">
      <span class="wa-invite-section-icon" aria-hidden="true"><i class="bi bi-clock-history"></i></span>
      <div><p class="eyebrow">02 / HISTORY</p><h2 class="h5"><%= t("e2.sent_title") %></h2></div>
    </div>
    <% if @invitations.any? %>
      <ul class="rc-record-list">
        <% @invitations.each do |invite| %>
          <li class="rc-record d-flex flex-wrap justify-content-between gap-3">
            <div><strong><%= invite.seed_title %></strong>
              <p class="rc-hint mb-0"><%= t("e2.state_#{invite.state}") %> ·
                <time datetime="<%= invite.expires_at.iso8601 %>"><%= l(invite.expires_at, format: :short) %></time></p>
            </div>
            <% if invite.claimed_at.nil? && invite.revoked_at.nil? && invite.expires_at.future? %>
              <%= button_to t("e2.revoke_action"), revoke_owner_invitation_path(invite),
                    method: :post, class: "rc-action rc-action--quiet rc-action--small" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="rc-empty-state"><i class="bi bi-envelope-paper" aria-hidden="true"></i><p><%= t("e2.none_yet") %></p></div>
    <% end %>
  </section>
</div>
