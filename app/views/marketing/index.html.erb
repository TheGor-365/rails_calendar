<div class="mk-container mk-workspace">
  <aside class="mk-sidebar" aria-label="<%= t("marketing.sidebar_aria") %>">
    <p class="mk-sidebar-label"><%= t("marketing.sidebar_heading") %></p>
    <nav class="mk-sidebar-nav" aria-label="<%= t("marketing.sidebar_nav") %>">
      <a href="#overview"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#grid"></use></svg><%= t("marketing.sidebar_overview") %></a>
      <a href="#services" class="is-current" aria-current="location"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#layers"></use></svg><%= t("marketing.sidebar_services") %></a>
      <button type="button" class="mk-section-trigger" data-mk-open="process"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#route"></use></svg><%= t("marketing.sidebar_process") %></button>
      <a href="#evidence"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#code"></use></svg><%= t("marketing.sidebar_evidence") %></a>
      <a href="#contact"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#message"></use></svg><%= t("marketing.sidebar_contact") %></a>
    </nav>
    <div class="mk-sidebar-note">
      <span class="mk-state-dot" aria-hidden="true"></span>
      <p><strong><%= t("marketing.sidebar_public") %></strong><br><%= t("marketing.sidebar_note") %></p>
    </div>
  </aside>

  <div class="mk-content">
    <section class="mk-compact-banner" id="overview" aria-labelledby="mk-main-title">
      <h1 class="mk-kicker" id="mk-main-title"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#grid"></use></svg> <%= t("marketing.services_label") %></h1>
      <div class="mk-intro-actions">
        <a class="mk-action mk-action-primary" href="#services"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#grid"></use></svg> <%= t("marketing.hero_pick") %></a>
        <button type="button" class="mk-action mk-action-quiet" data-mk-open="process"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#route"></use></svg> <%= t("marketing.nav_process") %></button>
      </div>
    </section>

    <section class="mk-section" id="services" aria-labelledby="services-title">
      <h2 class="mk-visually-hidden" id="services-title"><%= t("marketing.services_title") %></h2>
      <%# Publication pointers are shared with the verified-client selection form.
          No draft fields, private attachments, account identifiers or profile data. %>
      <% published_services = ServiceOffering.joins(:published_version)
           .includes(:published_version).order(:workspace_id, :position, :id) %>
      <% if published_services.any? %>
        <div class="mk-service-grid mk-published-catalogue">
          <% published_services.each_with_index do |offering, index| %>
            <% version = offering.published_version %>
            <article class="marketing-service mk-service-card">
              <%= link_to(client_signed_in? && ClientRequestPilot.enabled?(request: request) ?
                    new_client_request_path(service_version_id: version.id) : "#contact") do %>
                <span class="mk-service-top"><span class="mk-service-icon"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#briefcase"></use></svg></span><span class="mk-service-index"><%= format("%02d", index + 1) %></span></span>
                <h3><%= version.title %></h3>
                <p><%= version.summary %></p>
                <p><strong><%= t("owner_services.included_scope") %></strong><br><%= version.included_scope %></p>
                <span class="mk-service-footer"><%= client_signed_in? && ClientRequestPilot.enabled?(request: request) ? t("client_requests.new_action") : t("marketing.service_discuss") %> <svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#arrow-up-right"></use></svg></span>
              <% end %>
              <details class="mk-footer-disclosure mk-service-tech"><summary><%= t("marketing.technologies", default: "Technologies") %></summary><% domains = OwnerServices::PublicPresentation.new(offering).technology_domains %>
                <% if domains.any? %>
                  <ul class="mk-tech-list"><% domains.each do |domain| %><li><%= t("owner_setup.options.B.#{domain}") %></li><% end %></ul>
                <% else %><p><%= t("marketing.technology_on_request", default: "Technology stack agreed during assessment") %></p><% end %></details>
            </article>
          <% end %>
        </div>
      <% else %>
        <p><%= t("client_requests.no_published_services") %></p>
        <a class="mk-action mk-action-primary" href="#contact"><%= t("marketing.service_discuss") %></a>
      <% end %>
    </section>

    <dialog class="mk-process-dialog" id="process" aria-labelledby="process-title">
      <header class="mk-dialog-heading">
        <h2 id="process-title"><%= t("marketing.nav_process") %></h2>
        <button class="mk-action mk-action-quiet" type="button" data-mk-close="process" aria-label="<%= t("marketing.close_dialog") %>">×</button>
      </header>
      <ol class="mk-process">
        <% %w[request clarify proposal specification build delivery].zip(%w[message checklist clipboard checklist code check]).each_with_index do |(stage, icon), index| %>
          <li><span class="mk-process-symbol"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#<%= icon %>"></use></svg></span><div><strong><%= t("marketing.workflow_stages.#{stage}.title") %></strong><p><%= t("marketing.workflow_stages.#{stage}.description") %></p></div><span class="mk-process-order"><%= format("%02d", index + 1) %></span></li>
        <% end %>
      </ol>
      <p class="mk-workflow-scope"><%= t("marketing.workflow_availability") %></p>
    </dialog>

    <section class="mk-section mk-contact-section" id="contact" aria-labelledby="contact-title">
      <div class="mk-contact-card">
        <div class="mk-contact-copy">
          <span class="mk-kicker"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#message"></use></svg> <%= t("marketing.contact_label") %></span>
          <h2 class="mk-visually-hidden" id="contact-title"><%= t("marketing.contact_label") %></h2>
        </div>
        <div class="mk-contact-links">
          <a class="mk-action mk-action-primary" href="https://www.facebook.com/gor.webdevelopment/" rel="noopener noreferrer"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#message"></use></svg> Facebook Page <svg class="mk-icon mk-icon-trailing" aria-hidden="true"><use href="/workspace-icons.svg#arrow-up-right"></use></svg></a>
          <a class="mk-action mk-action-quiet" href="https://kwork.com/user/thegor-365" rel="noopener noreferrer"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#briefcase"></use></svg> <%= t("marketing.contact_kwork") %> <svg class="mk-icon mk-icon-trailing" aria-hidden="true"><use href="/workspace-icons.svg#arrow-up-right"></use></svg></a>
        </div>
      </div>
    </section>
    <details class="mk-footer-disclosure" id="evidence"><summary><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#code"></use></svg> <%= t("marketing.sidebar_evidence") %></summary><div class="mk-evidence-links">
        <a href="https://github.com/TheGor-365/rails_calendar" rel="noopener noreferrer"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#code"></use></svg><span><%= t("marketing.evidence_repo") %><small><%= t("marketing.evidence_repo_sub") %></small></span><svg class="mk-icon mk-icon-trailing" aria-hidden="true"><use href="/workspace-icons.svg#arrow-up-right"></use></svg></a>
        <a href="https://github.com/TheGor-365" rel="noopener noreferrer"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#grid"></use></svg><span><%= t("marketing.evidence_other") %><small><%= t("marketing.evidence_other_sub") %></small></span><svg class="mk-icon mk-icon-trailing" aria-hidden="true"><use href="/workspace-icons.svg#arrow-up-right"></use></svg></a>
        <a href="https://kwork.com/user/thegor-365" rel="noopener noreferrer"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#briefcase"></use></svg><span><%= t("marketing.evidence_kwork") %><small><%= t("marketing.evidence_kwork_sub") %></small></span><svg class="mk-icon mk-icon-trailing" aria-hidden="true"><use href="/workspace-icons.svg#arrow-up-right"></use></svg></a>
      </div>
    </details>

  </div>
</div>
