<div class="container my-4 my-sm-5">
  <header class="rc-page-hero mb-4"><div class="rc-page-hero__content">
    <p class="eyebrow"><%= t("e2.guest_eyebrow") %></p>
    <div class="rc-page-hero__heading"><span class="rc-page-hero__symbol" aria-hidden="true"><i class="bi bi-envelope-open"></i></span>
      <h1 class="page-title"><%= t("e2.guest_title") %></h1></div>
    <p class="rc-muted"><%= t("e2.guest_hint") %></p>
  </div></header>
  <section class="surface-panel p-3 p-sm-4">
    <%= form_with url: client_invitation_preview_path, method: :post,
          html: { class: "rc-form", data: { controller: "wa-invitation-link" } } do %>
      <div class="rc-field">
        <%= label_tag :invite_token, t("e2.invite_token_label"), class: "rc-field-label" %>
        <%= text_field_tag :invite_token, "", class: "rc-input", required: true,
              minlength: 64, maxlength: 64, pattern: "[0-9a-f]{64}",
              autocomplete: "off", spellcheck: false, data: { wa_invitation_link_target: "token" } %>
      </div>
      <button type="submit" class="rc-action rc-action--primary">
        <%= rc_icon_label("arrow-right", t("e2.open_preview")) %>
      </button>
    <% end %>
    <p class="rc-hint mt-3"><%= t("e2.guest_safety") %></p>
  </section>
</div>
