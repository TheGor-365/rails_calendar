<div class="container my-4 my-sm-5">
  <header class="rc-page-hero mb-4">
    <div>
      <p class="eyebrow mb-2"><%= t("consultations.all_eyebrow") %></p>
      <div class="rc-page-hero__heading"><span class="rc-page-hero__symbol" aria-hidden="true"><i class="bi bi-journal-text"></i></span><h1 class="page-title mb-1"><%= t("consultations.title") %></h1></div>
      <p class="rc-muted mb-0"><%= t("consultations.list_hint") %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to rc_icon_label("calendar3", t("consultations.calendar")), root_path, class: "rc-action rc-action--quiet" %>
      <% if admin_signed_in? %>
        <%= link_to rc_icon_label("plus-lg", t("consultations.new")), new_consultation_path, class: "rc-action rc-action--primary" %>
      <% end %>
    </div>
  </header>

  <%= form_with url: consultations_path, method: :get, local: true,
                html: { class: "rc-consultation-filters", role: "search",
                        aria: { label: t("consultations.filter_aria") } } do %>
    <div class="rc-filter-grid">
      <div class="rc-filter-field">
        <%= label_tag :q, t("consultations.title_contains"), class: "rc-field-label" %>
        <%= search_field_tag :q, @search.query,
                             class: "rc-input rc-filter-input",
                             maxlength: ConsultationSearch::MAX_QUERY_LENGTH,
                             placeholder: t("consultations.search_placeholder") %>
      </div>
      <div class="rc-filter-field">
        <%= label_tag :from, t("consultations.from"), class: "rc-field-label" %>
        <%= date_field_tag :from, @search.from_value,
                           class: "rc-input rc-filter-input",
                           min: "2000-01-01", max: "2100-12-31" %>
      </div>
      <div class="rc-filter-field">
        <%= label_tag :to, t("consultations.to"), class: "rc-field-label" %>
        <%= date_field_tag :to, @search.to_value,
                           class: "rc-input rc-filter-input",
                           min: "2000-01-01", max: "2100-12-31" %>
      </div>
      <div class="rc-filter-field">
        <%= label_tag :status, t("consultations.status"), class: "rc-field-label" %>
        <%= select_tag :status,
                       options_for_select([[t("consultations.all"), "all"], [t("consultations.upcoming"), "upcoming"],
                                           [t("consultations.ongoing"), "ongoing"], [t("consultations.past"), "past"]], @search.status),
                       class: "rc-input rc-filter-input" %>
      </div>
    </div>
    <div class="rc-filter-actions">
      <%= button_tag rc_icon_label("search", t("consultations.apply")),
                     type: :submit, class: "rc-action rc-action--primary" %>
      <%= link_to rc_icon_label("arrow-counterclockwise", t("consultations.clear")), consultations_path,
                  class: "rc-action rc-action--quiet" %>
      <p class="rc-hint mb-0"><%= t("consultations.range_hint") %></p>
    </div>
  <% end %>

  <% if @search.errors.any? %>
    <div class="rc-notice rc-notice--error mb-3" role="alert" id="consultation-filter-errors">
      <%= @search.errors.join(". ") %>
    </div>
  <% end %>

  <p class="rc-results-summary" role="status" aria-live="polite">
    <% if @search.errors.any? %>
      <%= t("consultations.filter_invalid") %>
    <% elsif @search.total.zero? %>
      <%= @search.filtered? ? t("consultations.no_matches") : t("consultations.none_scheduled") %>
    <% else %>
      <%= t("consultations.showing", first: @search.first_result, last: @search.last_result, total: rc_count(@search.total, "calendar", "consultation")) %>
    <% end %>
  </p>

  <% if @consultations.any? %>
    <ul id="consultations" class="rc-record-list">
      <% @consultations.each do |consultation| %>
        <li class="rc-record" id="<%= dom_id consultation %>">
          <div class="rc-record-head">
            <h2 class="h5 mb-0"><%= link_to consultation.title, consultation_path(consultation), class: "rc-record-title" %></h2>
            <span class="rc-record-meta">
              <time datetime="<%= consultation.start_time.iso8601 %>"><%= rc_local_datetime(consultation.start_time) %></time>
              <span aria-hidden="true">—</span>
              <time datetime="<%= consultation.end_time.iso8601 %>"><%= rc_local_datetime(consultation.end_time) %></time>
            </span>
          </div>
          <% if consultation.description.present? %>
            <p class="rc-muted mt-2 mb-0"><%= truncate(consultation.description, length: 140) %></p>
          <% end %>
          <div class="rc-record-actions">
            <%= link_to rc_icon_label("eye", t("consultations.view_details")), consultation_path(consultation), class: "rc-text-link" %>
            <% if admin_signed_in? %>
              <%= link_to rc_icon_label("calendar2-week", t("consultations.reschedule")),
                          edit_consultation_path(consultation, anchor: "consultation_start_time"),
                          class: "rc-text-link", aria: { label: t("consultations.reschedule_aria", title: consultation.title) } %>
            <% end %>
            <%= link_to rc_icon_label("calendar-event", t("consultations.view_calendar")),
                        calendar_day_path(date: consultation.start_time.in_time_zone.to_date.iso8601, anchor: "event-#{consultation.id}"),
                        class: "rc-text-link" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div id="consultations" class="rc-empty-state rc-notice--neutral" role="status">
      <span class="rc-empty-state__icon" aria-hidden="true"><i class="bi bi-calendar-x"></i></span>
      <% if @search.errors.any? %>
        <%= t("consultations.filters_correct") %>
      <% elsif @search.filtered? %>
        <%= t("consultations.filters_empty") %>
      <% else %>
        <%= t("consultations.none_ever") %>
      <% end %>
    </div>
  <% end %>

  <% if @search.total_pages > 1 %>
    <nav class="rc-pagination" aria-label="<%= t("consultations.pagination_aria") %>">
      <% if @search.page > 1 %>
        <%= link_to rc_icon_label("chevron-left", t("consultations.previous")),
                    consultations_path(@search.page_params(@search.page - 1)),
                    class: "rc-action rc-action--quiet", rel: "prev" %>
      <% end %>
      <span class="rc-pagination-current" aria-current="page">
        <%= t("consultations.page_of", page: @search.page, total: @search.total_pages) %>
      </span>
      <% if @search.page < @search.total_pages %>
        <%= link_to rc_icon_label("chevron-right", t("consultations.next")),
                    consultations_path(@search.page_params(@search.page + 1)),
                    class: "rc-action rc-action--quiet", rel: "next" %>
      <% end %>
    </nav>
  <% end %>
</div>
