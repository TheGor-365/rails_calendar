<div class="container my-4 my-sm-5">
  <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <p class="eyebrow mb-2">SCHEDULE / RECORDS</p>
      <h1 class="page-title mb-0">Consultations</h1>
    </div>
    <% if admin_signed_in? %>
      <%= link_to "New consultation", new_consultation_path, class: "rc-action rc-action--primary" %>
    <% end %>
  </header>

  <% if @consultations.any? %>
    <ul id="consultations" class="rc-record-list">
      <% @consultations.each do |consultation| %>
        <li class="rc-record">
          <%= render consultation %>
          <%= link_to "Show this consultation", consultation, class: "rc-text-link mt-2" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p id="consultations" role="status" class="rc-notice rc-notice--neutral">
      No consultations have been scheduled.
    </p>
  <% end %>
</div>
