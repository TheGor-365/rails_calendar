<div class="container my-4 my-sm-5">
  <div class="content-page">
    <header class="mb-4">
      <p class="eyebrow mb-2">SCHEDULE / SESSION</p>
      <h1 class="page-title mb-1">Consultation details</h1>
      <p class="rc-muted mb-0">Session details, duration and direct calendar navigation.</p>
    </header>
    <div class="surface-panel">
      <%= render @consultation %>
      <div class="rc-detail-meta">
        <strong>Duration:</strong>
        <%= rc_consultation_duration(@consultation.start_time, @consultation.end_time) %>
        <span aria-hidden="true">·</span>
        <%= @consultation.end_time <= Time.current ? "Past" : (@consultation.start_time <= Time.current ? "In progress by scheduled time" : "Upcoming") %>
      </div>
    </div>

    <% final_date = (@consultation.end_time - 1.second).in_time_zone.to_date %>
    <% spans_multiple_days = final_date > @consultation.start_time.in_time_zone.to_date %>

    <nav class="rc-detail-actions mt-3" aria-label="Consultation actions">
      <div class="rc-detail-primary-actions <%= 'rc-detail-primary-actions--two' unless spans_multiple_days %>"
           role="group" aria-label="Calendar navigation">
        <%= link_to rc_responsive_icon_label("calendar-event", "View in calendar", "Calendar"),
                    calendar_day_path(date: @consultation.start_time.in_time_zone.to_date.iso8601, anchor: "event-#{@consultation.id}"),
                    class: "rc-action rc-action--primary", aria: { label: "View in calendar" } %>
        <% if spans_multiple_days %>
          <%= link_to rc_responsive_icon_label("calendar-check", "See final day", "Final day"),
                      calendar_day_path(date: final_date.iso8601, anchor: "event-#{@consultation.id}"),
                      class: "rc-action rc-action--quiet", aria: { label: "See final day" } %>
        <% end %>
        <%= link_to rc_responsive_icon_label("list-ul", "All consultations", "All"),
                    consultations_path, class: "rc-action rc-action--quiet",
                    aria: { label: "All consultations" } %>
      </div>

      <% if admin_signed_in? %>
        <div class="rc-detail-admin-actions" role="group" aria-label="Administrator consultation actions">
          <%= link_to rc_responsive_icon_label("pencil-square", "Edit this consultation", "Edit"),
                      edit_consultation_path(@consultation),
                      class: "rc-action rc-action--quiet",
                      aria: { label: "Edit this consultation" } %>
          <%= button_to @consultation, method: :delete,
                        class: "rc-action rc-action--danger",
                        aria: { label: "Destroy this consultation" },
                        data: { turbo_confirm: "Delete consultation ##{@consultation.id} — #{@consultation.title} (#{@consultation.start_time.in_time_zone.strftime('%d %b %Y, %H:%M %Z')})? This cannot be undone." } do %>
            <%= rc_responsive_icon_label("trash3", "Destroy this consultation", "Delete") %>
          <% end %>
        </div>
      <% end %>
    </nav>
  </div>
</div>
