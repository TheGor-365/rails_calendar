<% if overlaps.present? %>
  <aside class="rc-overlap-notice" role="status" aria-label="<%= t("consultations.overlap_aria") %>">
    <p class="rc-overlap-heading mb-1">
      <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
      <strong><%= t("consultations.overlap_heading") %></strong>
      <%= rc_count(overlaps.length, "consultations", "other") %><%= " " + t("consultations.overlap_more") if more %>
    </p>
    <p class="rc-hint mb-2">
      <%= t("consultations.overlap_description") %>
      <% if mode == :form %>
        <%= t("consultations.overlap_form_help") %>
      <% end %>
    </p>
    <ul class="rc-overlap-list">
      <% overlaps.each do |other| %>
        <li>
          <%= link_to other.title, consultation_path(other), class: "rc-text-link" %>
          <span class="rc-overlap-range">
            <%= rc_local_datetime(other.start_time, format: :rc_short_time) %>–
            <%= rc_local_datetime(other.end_time, format: :rc_short_time) %> UTC
          </span>
        </li>
      <% end %>
    </ul>
  </aside>
<% end %>
