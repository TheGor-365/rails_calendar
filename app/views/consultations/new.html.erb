<div class="container my-4 my-sm-5">
  <div class="form-page">
    <% banner_actions = capture do %>
    <%= link_to rc_icon_label("journal-text", t("consultations.title")), consultations_path, class: "rc-action rc-action--quiet" %>
      <% if owner_signed_in? %>
        <%= link_to rc_icon_label("stars", t("consultations.ai_prepare", default: "Prepare with AI")), owner_ai_assistant_path(operation: "plan_outline"), class: "rc-action rc-action--quiet", target: "_blank", rel: "noopener" %>
      <% end %>
  <% end %>
  <%= render "shared/wa_banner", icon: "calendar-plus", path: t("consultations.scheduling") + " / " + t("consultations.new"), title: t("consultations.new"), extra_class: "rc-page-hero mb-4", actions: banner_actions %>
    <section class="surface-panel" aria-label="<%= t("consultations.details_title") %>">
      <%= render "form", consultation: @consultation %>
    </section>
  </div>
</div>
