      <p class="eyebrow mb-2">Scheduling</p>
      <div class="rc-page-hero__heading"><span class="rc-page-hero__symbol" aria-hidden="true"><i class="bi bi-calendar-plus"></i></span><h1 class="page-title mb-2">New consultation</h1></div>
