<article id="<%= dom_id consultation %>" aria-label="<%= consultation.title.presence || t('consultations.details_title') %>">
  <h2 class="h5"><%= consultation.title.presence || t("consultations.untitled") %></h2>
  <% if consultation.description.present? %>
    <p class="text-break"><%= consultation.description %></p>
  <% end %>
  <dl class="row mb-0">
    <dt class="col-sm-3"><%= t("consultations.start_time") %></dt>
    <dd class="col-sm-9">
      <% if consultation.start_time.present? %>
        <time datetime="<%= consultation.start_time.iso8601 %>">
          <%= rc_local_datetime(consultation.start_time, format: :rc_date_time_zone) %>
        </time>
      <% else %>
        <%= t('consultations.not_specified') %>
      <% end %>
    </dd>
    <dt class="col-sm-3"><%= t("consultations.end_time") %></dt>
    <dd class="col-sm-9">
      <% if consultation.end_time.present? %>
        <time datetime="<%= consultation.end_time.iso8601 %>">
          <%= rc_local_datetime(consultation.end_time, format: :rc_date_time_zone) %>
        </time>
      <% else %>
        <%= t('consultations.not_specified') %>
      <% end %>
    </dd>
  </dl>
</article>
