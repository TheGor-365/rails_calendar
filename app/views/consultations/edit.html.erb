<div class="container my-4 my-sm-5">
  <div class="form-page">
    <%= render "shared/wa_banner", icon: "pencil-square", path: t("consultations.scheduling") + " / " + t("consultations.editing"), title: t("consultations.editing"), description: t("consultations.editing_hint"), extra_class: "mb-4" %>
    <section class="surface-panel" aria-label="<%= t("consultations.details_title") %>">
      <%= render "form", consultation: @consultation %>
    </section>
    <div class="mt-3">
      <%= link_to rc_icon_label("eye", t("consultations.show_this")), @consultation, class: "rc-action rc-action--soft" %>
    </div>
  </div>
</div>
