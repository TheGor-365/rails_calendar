<div class="container my-4 my-sm-5">
  <div class="form-page">
    <header class="mb-4">
      <p class="eyebrow mb-2"><%= t("consultations.scheduling") %></p>
      <div class="rc-page-hero__heading"><span class="rc-page-hero__symbol" aria-hidden="true"><i class="bi bi-pencil-square"></i></span><h1 class="page-title mb-2"><%= t("consultations.editing") %></h1></div>
      <p class="text-secondary mb-0"><%= t("consultations.editing_hint") %></p>
    </header>
    <section class="surface-panel" aria-label="<%= t("consultations.details_title") %>">
      <%= render "form", consultation: @consultation %>
    </section>
    <div class="mt-3">
      <%= link_to rc_icon_label("eye", t("consultations.show_this")), @consultation, class: "rc-action rc-action--soft" %>
    </div>
  </div>
</div>
