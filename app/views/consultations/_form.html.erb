<%= form_with(model: consultation, html: { class: "consultation-form rc-form" }) do |form| %>
  <% if consultation.persisted? %>
    <%= form.hidden_field :lock_version %>
  <% end %>
  <% if consultation.errors.any? %>
    <div id="consultation-form-errors" class="rc-notice rc-notice--error mb-4" role="alert" tabindex="-1">
      <h2 class="h6 fw-semibold"><%= t("consultations.error_heading", errors: rc_count(consultation.errors.count, "consultations", "error")) %></h2>
      <ul class="mb-0">
        <% consultation.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p id="consultation-timezone-hint" class="rc-hint mb-4">
    <%= t("consultations.required_hint", zone: Time.zone.name, min: Consultation::MIN_SCHEDULE_YEAR, max: Consultation::MAX_SCHEDULE_YEAR) %>
  </p>

  <div class="rc-field">
    <%= form.label :title, t("consultations.field_title"), class: "rc-field-label" %>
    <%= form.text_field :title, class: "rc-input#{' rc-input--invalid' if consultation.errors.include?(:title)}",
                        maxlength: 120, required: true, autocomplete: "off",
                        aria: { invalid: consultation.errors.include?(:title) } %>
    <% if consultation.errors.include?(:title) %>
      <p class="rc-field-error"><%= consultation.errors.full_messages_for(:title).join(", ") %></p>
    <% end %>
  </div>

  <div class="rc-field">
    <%= form.label :description, t("consultations.field_description"), class: "rc-field-label" %>
    <%= form.text_area :description, rows: 3, maxlength: 5000,
                      class: "rc-input rc-input--area#{' rc-input--invalid' if consultation.errors.include?(:description)}",
                      aria: { invalid: consultation.errors.include?(:description) } %>
    <% if consultation.errors.include?(:description) %>
      <p class="rc-field-error"><%= consultation.errors.full_messages_for(:description).join(", ") %></p>
    <% end %>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-12 col-md-6 rc-field">
      <%= form.label :start_time, t("consultations.field_start"), class: "rc-field-label" %>
      <%= form.datetime_field :start_time,
                              class: "rc-input#{' rc-input--invalid' if consultation.errors.include?(:start_time)}",
                              value: consultation.start_time&.in_time_zone&.strftime("%Y-%m-%dT%H:%M"),
                              required: true, min: "2000-01-01T00:00", max: "2100-12-31T23:59", step: 60,
                              aria: { invalid: consultation.errors.include?(:start_time),
                                      describedby: "consultation-timezone-hint" } %>
      <% if consultation.errors.include?(:start_time) %>
        <p class="rc-field-error"><%= consultation.errors.full_messages_for(:start_time).join(", ") %></p>
      <% end %>
    </div>

    <div class="col-12 col-md-6 rc-field">
      <%= form.label :end_time, t("consultations.field_end"), class: "rc-field-label" %>
      <%= form.datetime_field :end_time,
                              class: "rc-input#{' rc-input--invalid' if consultation.errors.include?(:end_time)}",
                              value: consultation.end_time&.in_time_zone&.strftime("%Y-%m-%dT%H:%M"),
                              required: true, min: "2000-01-01T00:00", max: "2100-12-31T23:59", step: 60,
                              aria: { invalid: consultation.errors.include?(:end_time),
                                      describedby: "consultation-timezone-hint" } %>
      <% if consultation.errors.include?(:end_time) %>
        <p class="rc-field-error"><%= consultation.errors.full_messages_for(:end_time).join(", ") %></p>
      <% end %>
    </div>
  </div>

  <% if consultation.persisted? %>
    <div class="rc-field">
      <%= form.label :reschedule_reason, t("consultations.reschedule_reason"), class: "rc-field-label" %>
      <%= form.text_area :reschedule_reason, rows: 2, maxlength: 500,
                        placeholder: t("consultations.reschedule_placeholder"),
                        class: "rc-input rc-input--area#{' rc-input--invalid' if consultation.errors.include?(:reschedule_reason)}",
                        aria: { describedby: "reschedule-reason-help",
                                invalid: consultation.errors.include?(:reschedule_reason) } %>
      <p id="reschedule-reason-help" class="rc-hint mt-2">
        <%= t("consultations.reschedule_help") %>
      </p>
      <% if consultation.errors.include?(:reschedule_reason) %>
        <p class="rc-field-error"><%= consultation.errors.full_messages_for(:reschedule_reason).join(", ") %></p>
      <% end %>
    </div>
  <% end %>

  <p class="rc-hint mb-3"><%= t("consultations.overlap_hint") %></p>
  <%= render "overlap_advisory", overlaps: @overlaps, more: @overlaps_more, mode: :form %>

  <div class="d-flex flex-wrap align-items-center gap-2">
    <%= form.button type: :submit, class: "rc-action rc-action--primary" do %>
      <%= rc_icon_label(consultation.persisted? ? "check2-circle" : "plus-lg", consultation.persisted? ? t("consultations.update_action") : t("consultations.create_action")) %>
    <% end %>
    <%= link_to rc_icon_label("x-lg", t("consultations.cancel")), consultations_path, class: "rc-action rc-action--quiet" %>
  </div>
<% end %>
