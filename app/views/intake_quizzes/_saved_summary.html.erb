<section class="surface-panel p-3 p-sm-4 rc-quiz-summary" aria-label="<%= t("quiz.summary_aria") %>">
  <p class="eyebrow mb-1"><%= t("quiz.summary_eyebrow") %></p>
  <h2 class="h5 mb-2"><i class="bi bi-card-checklist me-2" aria-hidden="true"></i><%= t("quiz.saved_answers") %></h2>
  <p class="rc-hint mb-3"><%= t("quiz.summary_hint") %></p>
  <% questions.each_with_index do |question, index| %>
    <% answer = saved_answers[question.fetch(:key)] %>
    <article class="rc-quiz-summary__item">
      <div class="rc-quiz-summary__heading">
        <strong><%= index + 1 %>. <%= index == 0 ? t('quiz.outcome') : t('quiz.features') %></strong>
        <span class="rc-quiz-status <%= answer ? 'rc-quiz-status--saved' : 'rc-quiz-status--empty' %>"><i class="bi bi-<%= answer ? 'check-circle' : 'dash-circle' %> me-1" aria-hidden="true"></i><%= answer ? t('quiz.saved') : t('quiz.missing') %></span>
      </div>
      <% if answer %>
        <% if answer.unsure? %>
          <p class="mb-1"><%= t("quiz.unsure_review") %></p>
        <% else %>
          <% if answer.selected_options.any? %>
            <ul class="rc-quiz-summary__choices">
              <% answer.selected_options.each do |option| %>
                <li><%= rc_quiz_option_label(@intake.project_type, question, option) %></li>
              <% end %>
            </ul>
          <% end %>
          <% if answer.other_text.present? %><p class="mb-1"><%= t("quiz.own_answer_review") %> <%= answer.other_text %></p><% end %>
        <% end %>
        <% if answer.comment.present? %><p class="rc-hint mb-1"><%= t("quiz.comment_review") %> <%= answer.comment %></p><% end %>
        <p class="rc-hint mb-0"><i class="bi bi-clock-history me-1" aria-hidden="true"></i><%= t("quiz.revision", revision: answer.revision) %></p>
      <% else %>
        <p class="rc-hint mb-0"><%= t("quiz.no_saved") %></p>
      <% end %>
    </article>
  <% end %>
</section>
