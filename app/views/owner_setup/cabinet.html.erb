<div class="container ws-account-page my-4 my-sm-5" id="owner-cabinet">
  <header class="ws-account-hero wa-compact-banner">
    <div class="ws-account-hero-copy">
      <p class="eyebrow"><i class="bi bi-person-badge" aria-hidden="true"></i> <%= t("account_hub.owner_eyebrow") %></p>
      <h1 class="visually-hidden"><%= t("account_hub.owner_title") %></h1>
      <div class="d-flex flex-wrap gap-2 my-2">
        <%= link_to rc_icon_label("person-vcard", t("account_hub.open_profile")), owner_practice_path, class: "rc-action rc-action--quiet" %>
        <%= link_to rc_icon_label("stars", t("account_hub.interview")), owner_setup_path(step: "A"), class: "rc-action rc-action--quiet", data: { wa_page_dialog: "frame" } %>
      </div>
      <div class="ws-account-meta">
        <span class="ws-account-chip"><i class="bi bi-shield-lock" aria-hidden="true"></i><%= t("account_hub.private_scope") %></span>
        <span class="ws-account-chip"><i class="bi bi-person-check" aria-hidden="true"></i><%= current_user.email %></span>
      </div>
    </div>
    <div class="ws-account-hero-symbol ws-account-avatar-frame" id="owner-avatar"
         data-controller="wa-avatar-editor wa-private-image"
         data-wa-avatar-editor-success-value="<%= t("account_hub.avatar_crop_ready") %>"
         data-wa-avatar-editor-failure-value="<%= t("account_hub.avatar_crop_failed") %>">
      <% if (avatar = local_owner_avatar_attachment(current_user)) %>
        <%= image_tag owner_avatar_file_path(avatar), class: "ws-account-avatar",
              alt: t("account_hub.avatar_alt"), loading: "lazy",
              data: { wa_private_image_target: "image",
                      action: "error->wa-private-image#failed" } %>
        <i class="bi bi-person-workspace ws-account-avatar-placeholder" aria-hidden="true"
           data-wa-private-image-target="fallback" hidden></i>
      <% else %>
        <i class="bi bi-person-workspace ws-account-avatar-placeholder" aria-hidden="true"></i>
      <% end %>
      <% if local_owner_avatar_enabled? %>
        <details class="ws-avatar-edit">
          <summary class="ws-avatar-edit-trigger" title="<%= t("account_hub.avatar_edit") %>"
                   aria-label="<%= t("account_hub.avatar_edit") %>">
            <i class="bi bi-pencil-square" aria-hidden="true"></i>
          </summary>
          <div class="ws-avatar-edit-panel">
            <div class="ws-avatar-edit-panel__heading">
              <span class="ws-avatar-edit-panel__icon"><i class="bi bi-image" aria-hidden="true"></i></span>
              <div>
                <strong><%= t("account_hub.avatar_title") %></strong>
                <p><%= t("account_hub.avatar_crop_hint") %></p>
              </div>
            </div>
            <%= form_with url: owner_avatars_path, method: :post, multipart: true,
                html: { id: "owner-avatar-form", class: "ws-account-avatar-form",
                        data: { action: "submit->wa-avatar-editor#guard" } } do %>
              <div class="wa-file-drop">
                <label for="owner-avatar-file">
                  <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                  <%= t("account_hub.avatar_file") %>
                </label>
                <%= file_field_tag "avatar[file]", id: "owner-avatar-file",
                    accept: "image/jpeg,image/png,image/webp", required: true,
                    data: { wa_avatar_editor_target: "file", action: "change->wa-avatar-editor#prepare" } %>
              </div>
              <div class="ws-avatar-edit-crop-preview" aria-label="<%= t("account_hub.avatar_alt") %>">
                <img class="ws-avatar-edit-crop-preview__image"
                     data-wa-avatar-editor-target="preview"
                     alt="<%= t("account_hub.avatar_alt") %>" hidden>
              </div>
              <p class="ws-avatar-edit-status" role="status" aria-live="polite"
                 data-wa-avatar-editor-target="status"></p>
              <%= button_tag type: "submit", class: "rc-action rc-action--primary",
                    data: { wa_avatar_editor_target: "submit" } do %>
                <%= rc_icon_label("check2", t("account_hub.avatar_upload")) %>
              <% end %>
            <% end %>
            <p class="rc-hint ws-avatar-edit-panel__footer"><i class="bi bi-shield-lock" aria-hidden="true"></i>
              <%= t("account_hub.avatar_hint") %></p>
          </div>
        </details>
      <% end %>
    </div>
  </header>

  <section class="ws-account-overview" id="owner-cabinet-overview" data-wa-dialog-refresh aria-label="<%= t('account_hub.owner_overview') %>">
    <div class="ws-account-metric">
      <span class="ws-account-metric-icon"><i class="bi bi-patch-check" aria-hidden="true"></i></span>
      <small><%= t("account_hub.profile_status") %></small>
      <strong><%= @snapshot ? t("account_hub.version_number", version: @snapshot.version) : t("account_hub.not_ready") %></strong>
      <span><%= @profile.onboarding_state == "draft" && @snapshot ? t("account_hub.unsaved_changes") : t("account_hub.profile_saved") %></span>
    </div>
    <div class="ws-account-metric">
      <span class="ws-account-metric-icon"><i class="bi bi-list-check" aria-hidden="true"></i></span>
      <small><%= t("account_hub.interview_steps") %></small>
      <strong><%= @answered_count %><span> / 6</span></strong>
      <span><%= t("account_hub.editable_answers") %></span>
    </div>
    <div class="ws-account-metric">
      <span class="ws-account-metric-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
      <small><%= t("account_hub.ai_spending") %></small>
      <strong><%= format("$%.5f", @ai_spend[:billed_ticks].to_f / AiSpendLedger::USD_TICKS) %></strong>
      <span><%= t("account_hub.ai_cap", cap: format("%.2f", @ai_spend[:cap_ticks].to_f / AiSpendLedger::USD_TICKS)) %></span>
    </div>
  </section>

  <div class="ws-account-content ws-account-content--rail" data-controller="wa-section-nav">
    <nav class="wa-cabinet-rail" aria-label="<%= t("nav.workspace_sections") %>">
      <a href="#cabinet-profile" data-wa-section-nav-target="link" data-action="click->wa-section-nav#activate"><i class="bi bi-person-vcard" aria-hidden="true"></i><%= t("account_hub.rail_profile", default: "Profile") %></a>
      <a href="#cabinet-tools" data-wa-section-nav-target="link" data-action="click->wa-section-nav#activate"><i class="bi bi-grid-1x2" aria-hidden="true"></i><%= t("account_hub.rail_ai", default: "AI settings") %></a>
      <a href="#cabinet-privacy" data-wa-section-nav-target="link" data-action="click->wa-section-nav#activate"><i class="bi bi-shield-lock" aria-hidden="true"></i><%= t("account_hub.rail_data", default: "Data") %></a>
    </nav>
    <section class="ws-account-main">
      <div class="ws-account-section-heading" id="cabinet-profile">
        <div><p class="eyebrow"><%= t("account_hub.profile_eyebrow") %></p><h2 class="visually-hidden"><%= t("account_hub.professional_profile") %></h2></div>
        <%= link_to rc_icon_label("arrow-up-right", t("account_hub.open_profile")), owner_practice_path, class: "rc-action rc-action--quiet rc-action--small" %>
      </div>
      <div class="ws-account-feature">
        <div class="ws-account-feature-icon"><i class="bi bi-person-vcard" aria-hidden="true"></i></div>
        <div class="ws-account-feature-copy">
          <h3><%= @snapshot&.payload&.dig("headline").presence || t("account_hub.profile_not_approved") %></h3>
          <p><%= @snapshot&.payload&.dig("private_summary").present? ? truncate(@snapshot.payload["private_summary"], length: 270) : t("account_hub.setup_explanation") %></p>
          <div class="ws-account-feature-foot">
            <span class="ws-account-status"><i class="bi bi-database-lock" aria-hidden="true"></i><%= t("account_hub.stored_private") %></span>
            <span class="ws-account-muted"><%= t("account_hub.version_count", count: @version_count) %></span>
          </div>
        </div>
      </div>

      <div class="ws-account-section-heading ws-account-section-heading--later" id="cabinet-tools">
        <div><p class="eyebrow"><%= t("account_hub.tools_eyebrow") %></p><h2 class="visually-hidden"><%= t("account_hub.owner_tools") %></h2></div>
      </div>
      <div class="ws-account-link-grid">
        <%# Identity and account settings only: operational areas have canonical homes. %>
        <%= link_to owner_setup_path(step: "A"), class: "ws-account-tool", data: { wa_page_dialog: "frame" } do %>
          <span class="ws-account-tool-icon"><i class="bi bi-chat-square-dots" aria-hidden="true"></i></span>
          <strong><%= t("account_hub.interview") %></strong><small><%= t("account_hub.interview_desc") %></small>
          <span class="ws-account-tool-arrow"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></span>
        <% end %>
        <%= link_to owner_capabilities_path, class: "ws-account-tool", data: { wa_page_dialog: "frame" } do %>
          <span class="ws-account-tool-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
          <strong><%= t("account_hub.capabilities") %></strong><small><%= t("account_hub.capabilities_desc") %></small>
          <span class="ws-account-tool-arrow"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></span>
        <% end %>
        <%= link_to owner_ai_activity_path, class: "ws-account-tool", data: { wa_page_dialog: "frame" } do %>
          <span class="ws-account-tool-icon"><i class="bi bi-cpu" aria-hidden="true"></i></span>
          <strong><%= t("account_hub.ai_activity") %></strong><small><%= t("account_hub.ai_activity_desc") %></small>
          <span class="ws-account-tool-arrow"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></span>
        <% end %>
      </div>
    </section>
    <aside class="ws-account-aside">
      <div class="ws-account-side-panel" id="cabinet-privacy">
        <span class="ws-account-side-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
        <h2><%= t("account_hub.storage_heading") %></h2>
        <p><%= t("account_hub.storage_explanation") %></p>
        <div class="ws-account-fact"><span><%= t("account_hub.data_scope") %></span><strong><%= t("account_hub.local_private") %></strong></div>
        <div class="ws-account-fact"><span><%= t("account_hub.public_visibility") %></span><strong><%= t("account_hub.not_published") %></strong></div>
        <div class="ws-account-fact"><span><%= t("account_hub.approval") %></span><strong><%= t("account_hub.owner_approval") %></strong></div>
      </div>
    </aside>
  </div>
</div>