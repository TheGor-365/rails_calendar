<div class="container my-4 my-sm-5" id="owner-setup">
  <header class="mb-4">
    <p class="eyebrow"><i class="bi bi-person-workspace" aria-hidden="true"></i> <%= t("owner_setup.eyebrow") %></p>
    <h1 class="page-title"><%= t("owner_setup.title") %></h1>
    <p class="rc-muted"><%= t("owner_setup.intro") %></p>
    <div class="d-flex justify-content-between align-items-center mb-2">
      <strong><%= t("owner_setup.progress", done: @answers.size, total: OwnerIntelligence::Catalog::KEYS.size) %></strong>
      <%= link_to t("owner_setup.my_practice"), owner_practice_path, class: "rc-action rc-action--quiet rc-action--small" %>
    </div>
    <div class="progress" role="progressbar" aria-label="<%= t('owner_setup.progress_label') %>" aria-valuenow="<%= @answers.size %>" aria-valuemin="0" aria-valuemax="6">
      <div class="progress-bar bg-success" style="width: <%= @answers.size * 100 / 6 %>%"></div>
    </div>
  </header>

  <div class="row g-3">
    <nav class="col-lg-3" aria-label="<%= t('owner_setup.step_navigation') %>">
      <div class="surface-panel p-3 h-100">
        <ol class="list-unstyled mb-0">
          <% OwnerIntelligence::Catalog::KEYS.each_with_index do |key, index| %>
            <li class="mb-2">
              <%= link_to owner_setup_path(step: key),
                  class: "d-block p-2 rounded text-decoration-none #{key == @current_key ? 'border border-success' : ''}",
                  aria: { current: ("step" if key == @current_key) } do %>
                <strong><%= index + 1 %>. <%= t("owner_setup.steps.#{key}.short") %></strong>
                <small class="d-block rc-muted"><%= @answers.key?(key) ? t("owner_setup.complete") : t("owner_setup.pending") %></small>
              <% end %>
            </li>
          <% end %>
        </ol>
      </div>
    </nav>

    <section class="col-lg-6" aria-labelledby="owner-current-question">
      <div class="surface-panel p-3 p-sm-4">
        <p class="eyebrow mb-2"><%= t("owner_setup.step_of", step: OwnerIntelligence::Catalog::KEYS.index(@current_key) + 1) %></p>
        <h2 class="h4" id="owner-current-question"><%= t("owner_setup.steps.#{@current_key}.title", default: @question.fetch(:title)) %></h2>
        <p class="rc-hint"><%= t("owner_setup.steps.#{@current_key}.hint", default: @question.fetch(:hint)) %></p>
        <%= form_with url: owner_setup_section_path(section_key: @current_key), method: :patch do %>
          <fieldset>
            <legend class="h6"><%= t("owner_setup.choose_options") %></legend>
            <%= hidden_field_tag "owner_answer[selected_options][]", "" %>
            <% @question.fetch(:options).each do |value, label| %>
              <% id = "owner-#{@current_key}-#{value}" %>
              <div class="form-check border rounded p-2 ps-4 mb-2">
                <%= check_box_tag "owner_answer[selected_options][]", value,
                    @answer.selected_options.include?(value), id: id, class: "form-check-input" %>
                <%= label_tag id, t("owner_setup.options.#{@current_key}.#{value}", default: label), class: "form-check-label" %>
              </div>
            <% end %>
          </fieldset>
          <div class="mt-3 mb-3">
            <%= label_tag "owner_notes", t("owner_setup.notes"), class: "rc-field-label" %>
            <%= text_area_tag "owner_answer[notes]", @answer.notes, id: "owner_notes",
                  rows: 4, maxlength: 800, class: "rc-input", placeholder: t("owner_setup.notes_placeholder") %>
          </div>
          <div class="form-check mb-3">
            <%= check_box_tag "owner_answer[unsure]", "1", @answer.unsure, id: "owner_unsure", class: "form-check-input" %>
            <%= label_tag "owner_unsure", t("owner_setup.not_sure"), class: "form-check-label" %>
          </div>
          <%= button_tag type: "submit", class: "rc-action rc-action--primary" do %>
            <%= rc_icon_label("check2-circle", t("owner_setup.save_continue")) %>
          <% end %>
        <% end %>
      </div>
    </section>

    <aside class="col-lg-3">
      <div class="surface-panel p-3">
        <h3 class="h6"><i class="bi bi-stars" aria-hidden="true"></i> <%= t("owner_setup.ai_context_heading") %></h3>
        <p class="rc-hint"><%= t("owner_setup.ai_context_help") %></p>
        <p class="rc-hint"><%= t("owner_setup.no_secrets") %></p>
        <p class="rc-muted"><%= t("owner_setup.manual_first") %></p>
        <%= link_to t("owner_setup.review_link"), owner_setup_review_path, class: "rc-action rc-action--quiet rc-action--small" if @profile.interview_complete? %>
      </div>
    </aside>
  </div>
</div>
