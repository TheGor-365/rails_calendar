<% settings_content = capture do %>
<div class="container ws-owner-page ws-owner-review my-4 my-sm-5" id="owner-setup-review">
  <header class="ws-owner-hero">
    <div class="ws-owner-hero-copy"><p class="eyebrow"><i class="bi bi-clipboard2-check" aria-hidden="true"></i> <%= t("owner_setup.eyebrow") %></p>
    <h1 class="page-title"><%= t("owner_setup.review_title") %></h1>
    </div>
    <div class="ws-owner-hero-actions"><%= link_to rc_icon_label("person-badge", t("account_hub.owner_cabinet")), owner_cabinet_path, class: "rc-action rc-action--quiet" %></div>
  </header>
  <div class="ws-owner-review-layout">
    <section class="ws-owner-review-answers" aria-label="<%= t('owner_setup.answer_review_label') %>">
      <div class="ws-owner-data-panel">
        <div class="ws-owner-data-head"><span class="ws-owner-data-icon"><i class="bi bi-list-check" aria-hidden="true"></i></span><h2><%= t("owner_setup.your_answers") %></h2></div>
        <% OwnerIntelligence::Catalog::KEYS.each do |key| %>
          <% answer = @answers.fetch(key) %>
          <div class="ws-owner-review-item">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <strong><%= t("owner_setup.steps.#{key}.short") %></strong>
              <%= link_to rc_icon_label("pencil-square", t("owner_setup.edit")), owner_setup_path(step: key), data: { turbo_frame: ("wa-settings-frame" if turbo_frame_request?) }, class: "ws-owner-inline-link" %>
            </div>
            <% if answer.selected_options.any? %>
              <ul class="list-unstyled mt-2 mb-2">
                <% answer.selected_options.each do |value| %>
                  <li class="d-flex align-items-start gap-2 mb-1"><i class="bi bi-check2 text-success" aria-hidden="true"></i><span><%= t("owner_setup.options.#{key}.#{value}", default: OwnerIntelligence::Catalog.options_for(key)[value]) %></span></li>
                <% end %>
              </ul>
            <% else %><p class="rc-hint"><%= t("owner_setup.no_options") %></p><% end %>
            <% if answer.notes.present? %><p class="rc-hint mb-1"><%= answer.notes %></p><% end %>
            <% if answer.unsure? %><small><%= t("owner_setup.unsure_tag") %></small><% end %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="ws-owner-review-main">
      <div class="ws-owner-data-panel ws-owner-review-ai mb-3">
        <div class="ws-owner-data-head"><span class="ws-owner-data-icon"><i class="bi bi-stars" aria-hidden="true"></i></span><h2><%= t("owner_setup.ai_proposal") %></h2></div>
        <% if @profile.ai_suggestion.present? && !@profile.fresh_ai_suggestion? %>
          <p class="rc-notice rc-notice--neutral"><%= t("owner_setup.ai_stale") %></p>
        <% end %>
        <p class="rc-hint"><%= t("owner_setup.ai_consent_explanation") %></p>
        <% if @ai_enabled %>
          <%= form_with url: owner_setup_suggest_path, method: :post, data: { turbo_frame: ("wa-settings-frame" if turbo_frame_request?) } do %>
            <%= button_tag type: "submit", name: "ai_consent", value: "1", class: "rc-action rc-action--primary" do %>
              <%= rc_icon_label("stars", t("owner_setup.generate_ai", default: "Analyze with Grok (paid)")) %>
            <% end %>
          <% end %>
        <% else %>
          <p class="rc-hint"><%= t("owner_setup.ai_disabled") %></p>
        <% end %>
        <% if @suggestion.present? %>
          <p class="rc-notice rc-notice--success"><%= t("owner_setup.ai_available") %></p>
          <% %w[suggested_services possible_stretch missing_facts risk_flags].each do |key| %>
            <% if @suggestion[key].present? %>
              <h3 class="h6 mt-3"><%= t("owner_setup.suggestion_sections.#{key}") %></h3>
              <ul class="ws-owner-suggestion-list"><% @suggestion[key].each do |item| %><li><i class="bi bi-dot" aria-hidden="true"></i><%= item %></li><% end %></ul>
            <% end %>
          <% end %>
        <% end %>
        <details class="ws-owner-details"><summary><i class="bi bi-wallet2" aria-hidden="true"></i> <%= t("account_hub.ai_spending") %></summary><p class="rc-hint"><%= t("owner_setup.budget", spent: format("%.5f", @spend[:billed_ticks].to_f / AiSpendLedger::USD_TICKS), cap: format("%.2f", @spend[:cap_ticks].to_f / AiSpendLedger::USD_TICKS)) %></p></details>
      </div>

      <div class="ws-owner-data-panel ws-owner-review-approval" id="owner-profile-approval">
        <div class="ws-owner-data-head"><span class="ws-owner-data-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span><h2><%= t("owner_setup.manual_review") %></h2></div>
        <p class="rc-hint"><%= t("owner_setup.manual_review_hint") %></p>
        <%= form_with url: owner_setup_approve_path, method: :post, data: { turbo_frame: ("wa-settings-frame" if turbo_frame_request?) }, class: "ws-owner-form" do %>
          <div class="ws-owner-field">
            <%= label_tag "owner_headline", t("owner_setup.headline"), class: "rc-field-label" %>
            <%= text_field_tag "professional_profile[headline]",
                  @profile.headline.presence || @suggestion["headline"], id: "owner_headline",
                  maxlength: 160, required: true, class: "rc-input" %>
          </div>
          <div class="ws-owner-field">
            <%= label_tag "owner_private_summary", t("owner_setup.private_summary"), class: "rc-field-label" %>
            <%= text_area_tag "professional_profile[private_summary]",
                  @profile.private_summary.presence || @suggestion["private_summary"],
                  id: "owner_private_summary", rows: 5, maxlength: 1500, required: true, class: "rc-input rc-input--area", data: { controller: "wa-autogrow", action: "input->wa-autogrow#resize" } %>
          </div>
          <div class="ws-owner-field">
            <%= label_tag "owner_public_summary", t("owner_setup.public_summary"), class: "rc-field-label" %>
            <%= text_area_tag "professional_profile[public_summary]",
                  @profile.public_summary.presence || @suggestion["public_summary"],
                  id: "owner_public_summary", rows: 4, maxlength: 1000, class: "rc-input rc-input--area", data: { controller: "wa-autogrow", action: "input->wa-autogrow#resize" } %>
            <small class="rc-hint"><%= t("owner_setup.not_published") %></small>
          </div>
          <%= button_tag type: "submit", name: "confirmation", value: "1", class: "rc-action rc-action--primary" do %>
            <%= rc_icon_label("shield-check", t("owner_setup.approve_action")) %>
          <% end %>
        <% end %>
      </div>
    </section>
  </div>
</div>

<% end %>
<% if turbo_frame_request? %>
  <%= turbo_frame_tag "wa-settings-frame", target: "_top" do %>
    <% if notice.present? %><p class="rc-notice rc-notice--success" role="status"><%= notice %></p><% end %>
    <% if alert.present? %><p class="rc-notice rc-notice--error" role="alert"><%= alert %></p><% end %>
    <%= settings_content %>
  <% end %>
<% else %>
  <%= settings_content %>
<% end %>
