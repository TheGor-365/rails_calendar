<div class="container my-4 my-sm-5">
  <header class="rc-page-hero mb-3">
    <div class="rc-page-hero__content">
      <p class="eyebrow">PROJECT STUDIO / RC-037 · LOCAL AI SETTINGS</p>
      <h1 class="page-title">Offline AI controls</h1>
      <p class="rc-muted"><%= @intake.title %> · <%= @workspace.name %></p>
      <p class="rc-hint">Owner-only, synthetic nonproduction configuration. No external AI,
        keys, client documents, provider network calls or spending are enabled.</p>
    </div>
  </header>

  <% if @error.present? %>
    <div role="alert" class="rc-notice rc-notice--error mb-3"><%= @error %></div>
  <% end %>
  <div role="status" class="rc-notice rc-notice--neutral mb-3">
    External providers: blocked by system policy. Actual AI cost: $0.
    Any proposal requires human review; these switches never authorize a client upload.
  </div>

  <div class="row g-3">
    <% [["workspace", @workspace_policy], ["project", @project_policy]].each do |level, policy| %>
      <div class="col-12 col-lg-6">
        <section class="surface-panel p-3 p-sm-4" aria-label="<%= level.capitalize %> AI policy">
          <h2 class="h5"><%= level.capitalize %> policy</h2>
          <p class="rc-hint"><%= level == "workspace" ? "Default upper bound for every project." :
            "Project policy can only restrict the workspace default." %></p>
          <%= form_with url: workspace_ai_settings_path(@workspace, @intake), method: :patch do %>
            <%= hidden_field_tag :scope, level %>
            <div class="rc-field mb-3">
              <%= label_tag "mode_#{level}", "Execution mode", class: "rc-field-label" %>
              <%= select_tag "policy[mode]",
                options_for_select([["Off", "off"], ["Offline deterministic only", "offline"],
                                    ["Reviewed provider (configured, execution blocked)", "reviewed_provider"]],
                                   policy&.mode || "off"),
                id: "mode_#{level}", class: "rc-input" %>
            </div>
            <div class="rc-field mb-2">
              <%= check_box_tag "policy[document_plan]", "1",
                policy&.allowed_purposes&.include?("document_plan") == true,
                id: "document_plan_#{level}" %>
              <%= label_tag "document_plan_#{level}", "Deterministic document plan only" %>
            </div>
            <div class="rc-field mb-3">
              <%= check_box_tag "policy[synthetic]", "1",
                policy&.allowed_data_classes&.include?("synthetic") == true,
                id: "synthetic_#{level}" %>
              <%= label_tag "synthetic_#{level}", "Fictional synthetic inputs only" %>
            </div>
            <p class="rc-hint">Token / USD budget limits default to zero. No provider integration or
              allocation ledger is active. The system's hard $0 spending limit overrides all settings.</p>
            <%= button_tag "Save #{level} policy", type: "submit", class: "rc-action rc-action--primary" %>
          <% end %>
        </section>
      </div>
    <% end %>
  </div>
  <div class="mt-3">
    <%= link_to "Back to source preview", workspace_source_preview_path(@workspace, @intake),
      class: "rc-action rc-action--soft" %>
  </div>
</div>
