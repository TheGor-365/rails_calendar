<details class="wa-ai-dock" id="owner-ai-dock" data-controller="wa-ai-dock">
  <summary class="wa-ai-dock__trigger" aria-label="<%= t("owner_ai_assistant.open") %>">
    <i class="bi bi-stars" aria-hidden="true"></i>
    <span><%= t("owner_ai_assistant.short_title") %></span>
  </summary>
  <div class="wa-ai-dock__panel" aria-label="<%= t("owner_ai_assistant.title") %>">
    <header class="wa-ai-dock__heading">
      <span class="wa-ai-dock__symbol" aria-hidden="true"><i class="bi bi-stars"></i></span>
      <div>
        <strong><%= t("owner_ai_assistant.title") %></strong>
      </div>
    </header>
    <%= link_to owner_ai_assistant_path, class: "wa-ai-dock__workspace-link" do %>
      <span class="wa-ai-dock__workspace-symbol"><i class="bi bi-columns-gap" aria-hidden="true"></i></span>
      <span class="wa-ai-dock__workspace-copy">
        <strong><%= t("owner_ai_assistant.full_page") %></strong>
      </span>
    <% end %>
    <%= form_with url: create_owner_ai_draft_path, method: :post, class: "wa-ai-dock__form" do %>
      <div class="rc-field">
        <%= label_tag "wa-dock-operation", t("owner_ai_assistant.operation"), class: "rc-field-label" %>
        <%= select_tag :operation, options_for_select(OwnerAi::OperationRegistry.keys.map { |key|
              [t("owner_ai_assistant.operation_#{key}"), key]
            }), id: "wa-dock-operation", class: "rc-input" %>
      </div>
      <div class="rc-field">
        <%= label_tag "wa-dock-brief", t("owner_ai_assistant.brief"), class: "rc-field-label" %>
        <%= text_area_tag :brief, nil, id: "wa-dock-brief", class: "rc-input rc-input--area",
              rows: 3, minlength: 12, maxlength: 1200, required: true,
              placeholder: t("owner_ai_assistant.placeholder") %>
      </div>
      <label class="wa-ai-dock__consent wa-ai-dock__consent--compact">
        <%= check_box_tag :paid_consent, "1", false, required: true %>
        <span><%= t("owner_ai_assistant.consent_short") %></span>
      </label>
      <details class="wa-ai-dock__cost-details">
        <summary><%= t("owner_ai_assistant.cost_more") %></summary>
        <p><%= t("owner_ai_assistant.consent") %></p>
      </details>
      <%= button_tag type: "submit", class: "rc-action rc-action--primary wa-ai-dock__submit" do %>
        <%= rc_icon_label("stars", t("owner_ai_assistant.generate")) %>
      <% end %>
    <% end %>
    <details class="wa-ai-dock__find">
      <summary>
        <i class="bi bi-search" aria-hidden="true"></i>
        <%= t("owner_ai_assistant.find_with_ai") %>
      </summary>
      <div class="wa-ai-dock__find-body">
        <div class="wa-ai-dock__find-categories" role="list" aria-label="<%= t('owner_ai_assistant.find_categories') %>">
          <span role="listitem"><i class="bi bi-file-earmark" aria-hidden="true"></i><%= t("owner_ai_assistant.find_files") %></span>
          <span role="listitem"><i class="bi bi-window-stack" aria-hidden="true"></i><%= t("owner_ai_assistant.find_pages") %></span>
          <span role="listitem"><i class="bi bi-info-circle" aria-hidden="true"></i><%= t("owner_ai_assistant.find_info") %></span>
          <span role="listitem"><i class="bi bi-calendar-event" aria-hidden="true"></i><%= t("owner_ai_assistant.find_dates") %></span>
          <span role="listitem"><i class="bi bi-list-check" aria-hidden="true"></i><%= t("owner_ai_assistant.find_tasks") %></span>
          <span role="listitem"><i class="bi bi-archive" aria-hidden="true"></i><%= t("owner_ai_assistant.find_archives") %></span>
        </div>
        <p class="rc-hint"><%= t("owner_ai_assistant.find_scope_note") %></p>
        <%= form_with url: navigate_owner_ai_path, method: :post, class: "wa-ai-dock__navigation" do %>
          <%= label_tag "wa-dock-command", t("owner_ai_assistant.navigate_label"), class: "visually-hidden" %>
          <%= text_field_tag :command, nil, id: "wa-dock-command", class: "rc-input",
                maxlength: 120, required: true, placeholder: t("owner_ai_assistant.navigate_placeholder") %>
          <%= button_tag type: "submit", class: "rc-action rc-action--quiet rc-action--small" do %>
            <%= rc_icon_label("signpost-split", t("owner_ai_assistant.navigate_button")) %>
          <% end %>
        <% end %>
      </div>
    </details>
    <nav class="wa-ai-dock__links" aria-label="<%= t("owner_ai_assistant.navigation") %>">
      <%= link_to owner_ai_conversations_path do %>
        <i class="bi bi-chat-square-text" aria-hidden="true"></i>
        <%= t("owner_ai_assistant.my_conversations") %>
      <% end %>
    </nav>
  </div>
</details>
