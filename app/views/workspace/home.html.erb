<div class="container ws-hub my-4 my-sm-5">
  <header class="ws-hub-header">
    <div><p class="eyebrow mb-2"><i class="bi bi-grid-1x2" aria-hidden="true"></i> <%= t("workspace.eyebrow") %></p>
      <h1><%= t("workspace.title") %></h1><p class="rc-muted mb-0"><%= t("workspace.description") %></p></div>
    <%= link_to rc_icon_label("plus-lg", t("workspace.new_consultation")), new_consultation_path, class: "rc-action rc-action--primary" %>
  </header>
  <section class="ws-hub-metrics" aria-label="<%= t("workspace.summary_aria") %>">
    <div class="ws-hub-metric"><i class="bi bi-calendar2-check" aria-hidden="true"></i><span><%= t("workspace.upcoming_metric") %></span><strong><%= @upcoming_count %></strong><small><%= t("workspace.upcoming_metric_note") %></small></div>
    <div class="ws-hub-metric"><i class="bi bi-inboxes" aria-hidden="true"></i><span><%= t("workspace.intakes_metric") %></span><strong><%= @intake_count %></strong><small><%= t("workspace.intakes_metric_note") %></small></div>
    <div class="ws-hub-metric"><i class="bi bi-clipboard-check" aria-hidden="true"></i><span><%= t("workspace.review_metric") %></span><strong><%= @review_count %></strong><small><%= t("workspace.review_metric_note") %></small></div>
  </section>
  <section class="ws-hub-section" aria-labelledby="ws-tools">
    <div class="ws-hub-section-head"><h2 id="ws-tools"><%= t("workspace.tools_heading") %></h2><span><i class="bi bi-shield-lock" aria-hidden="true"></i> <%= t("workspace.owner_only") %></span></div>
    <div class="ws-hub-tools">
      <%= link_to root_path, class: "ws-hub-tool" do %><span class="ws-hub-tool-icon"><i class="bi bi-calendar3" aria-hidden="true"></i></span><strong><%= t("workspace.calendar") %></strong><small><%= t("workspace.calendar_desc") %></small><span class="ws-hub-tool-action"><%= t("workspace.open") %> <i class="bi bi-arrow-up-right" aria-hidden="true"></i></span><% end %>
      <%= link_to consultations_path, class: "ws-hub-tool" do %><span class="ws-hub-tool-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span><strong><%= t("workspace.consultations") %></strong><small><%= t("workspace.consultations_desc") %></small><span class="ws-hub-tool-action"><%= t("workspace.open") %> <i class="bi bi-arrow-up-right" aria-hidden="true"></i></span><% end %>
      <%= link_to admin_project_intakes_path, class: "ws-hub-tool" do %><span class="ws-hub-tool-icon"><i class="bi bi-inboxes" aria-hidden="true"></i></span><strong><%= t("workspace.intakes") %></strong><small><%= t("workspace.intakes_desc") %></small><span class="ws-hub-tool-action"><%= t("workspace.open") %> <i class="bi bi-arrow-up-right" aria-hidden="true"></i></span><% end %>
      <%= link_to new_project_intake_path, class: "ws-hub-tool" do %><span class="ws-hub-tool-icon"><i class="bi bi-clipboard2-plus" aria-hidden="true"></i></span><strong><%= t("workspace.new_intake") %></strong><small><%= t("workspace.new_intake_desc") %></small><span class="ws-hub-tool-action"><%= t("workspace.start") %> <i class="bi bi-arrow-up-right" aria-hidden="true"></i></span><% end %>
    </div>
  </section>
  <div class="ws-hub-panels">
    <section class="ws-hub-panel" aria-labelledby="ws-upcoming">
      <div class="ws-hub-panel-head"><h2 id="ws-upcoming"><%= t("workspace.upcoming_heading") %></h2><%= link_to t("workspace.all_records"), consultations_path %></div>
      <% if @upcoming.any? %>
        <ul class="ws-hub-list"><% @upcoming.each do |item| %>
          <li><%= link_to consultation_path(item) do %><strong><%= item.title %></strong><small><%= item.start_time.in_time_zone.strftime("%d.%m.%Y · %H:%M UTC") %></small><i class="bi bi-chevron-right" aria-hidden="true"></i><% end %></li>
        <% end %></ul>
      <% else %><p class="ws-hub-empty"><%= t("workspace.upcoming_empty") %></p><% end %>
    </section>
    <section class="ws-hub-panel" aria-labelledby="ws-intakes">
      <div class="ws-hub-panel-head"><h2 id="ws-intakes"><%= t("workspace.recent_intakes") %></h2><%= link_to t("workspace.internal_list"), admin_project_intakes_path %></div>
      <% if @recent_intakes.any? %>
        <ul class="ws-hub-list"><% @recent_intakes.each do |item| %>
          <li><%= link_to project_intake_path(item) do %><strong><%= item.title %></strong><small><%= rc_intake_type(item.project_type) %> · <%= rc_intake_status(item.status) %></small><i class="bi bi-chevron-right" aria-hidden="true"></i><% end %></li>
        <% end %></ul>
      <% else %><p class="ws-hub-empty"><%= t("workspace.intakes_empty") %></p><% end %>
    </section>
  </div>
  <aside class="ws-hub-boundary"><i class="bi bi-shield-check" aria-hidden="true"></i>
    <div><strong><%= t("workspace.boundary_heading") %></strong>
      <p><%= t("workspace.boundary_text") %></p></div>
    <%= link_to rc_icon_label("globe", t("workspace.public_services")), services_path %>
  </aside>
</div>
