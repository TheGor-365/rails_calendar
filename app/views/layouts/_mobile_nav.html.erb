<%# RC-014: one-thumb navigation with real server-side destinations. %>
<% calendar_active = controller_name == "pages" && action_name == "home" %>
<% today_active = controller_name == "pages" && %w[day hour].include?(action_name) && @selected_date == Time.zone.today %>
<% consultations_active = controller_name == "consultations" && %w[index show].include?(action_name) %>
<% creation_active = controller_name == "consultations" && %w[new create].include?(action_name) %>
<% access_active = controller_path == "admin/sessions" %>

<% if client_signed_in? %>
<% client_cabinet_active = [client_home_path, client_cabinet_path].include?(request.path) || (controller_path == "client_requests" && %w[show review].include?(action_name)) %>
<% client_creation_active = controller_path == "client_requests" && %w[new create].include?(action_name) %>
<nav class="rc-mobile-dock rc-mobile-dock--client" aria-label="<%= t("nav.client_navigation") %>">
  <%= link_to rc_icon_label("grid-1x2", t("nav.client_home")), client_home_path,
              class: "rc-mobile-dock-item #{'is-active' if client_cabinet_active}",
              aria: { current: ("page" if [client_home_path, client_cabinet_path].include?(request.path)) } %>
  <% if ClientRequestPilot.enabled?(request: request) %>
    <%= link_to rc_icon_label("clipboard2-plus", t("nav.new")), new_client_request_path,
                class: "rc-mobile-dock-item #{'is-active' if client_creation_active}",
                aria: { label: t("client_requests.new_action"), current: ("page" if client_creation_active) } %>
  <% end %>
  <%= link_to rc_icon_label("globe", t("nav.overview")), services_path, class: "rc-mobile-dock-item" %>
</nav>
<% else %>
<nav class="rc-mobile-dock<%= ' rc-mobile-dock--owner' if owner_signed_in? %>" aria-label="<%= t("nav.mobile_navigation") %>">
  <%= link_to root_path, class: "rc-mobile-dock-item #{'is-active' if calendar_active}",
              aria: { current: ("page" if calendar_active) } do %>
    <i class="bi bi-calendar3 rc-mobile-dock-icon" aria-hidden="true"></i>
    <span class="rc-mobile-dock-label"><%= t("nav.month") %></span>
  <% end %>

  <%= link_to calendar_day_path(date: Time.zone.today.iso8601),
              class: "rc-mobile-dock-item #{'is-active' if today_active}",
              aria: { current: ("page" if today_active) } do %>
    <i class="bi bi-calendar-day rc-mobile-dock-icon" aria-hidden="true"></i>
    <span class="rc-mobile-dock-label"><%= t("nav.day") %></span>
  <% end %>

  <%# Guests are sent to the existing login screen, never to a write action. %>
  <%= link_to(admin_signed_in? ? new_consultation_path : admin_login_path,
              class: "rc-mobile-dock-item rc-mobile-dock-item--create #{'is-active' if creation_active}",
              aria: { label: (admin_signed_in? ? t("nav.new_consultation") : t("nav.sign_in_to_create")),
                      current: ("page" if creation_active) }) do %>
    <span class="rc-mobile-dock-create-icon"><i class="bi bi-plus-lg" aria-hidden="true"></i></span>
    <span class="rc-mobile-dock-label"><%= t("nav.new") %></span>
  <% end %>

  <% if owner_signed_in? %>
    <%= link_to admin_project_intakes_path,
                class: "rc-mobile-dock-item wa-inbox-mobile #{'is-active' if ['admin/project_intakes', 'owner_invitations', 'owner_requirements'].include?(controller_path)}",
                aria: { label: t("requests_hub.title"), current: ("page" if ['admin/project_intakes', 'owner_invitations', 'owner_requirements'].include?(controller_path)) } do %>
      <span class="rc-mobile-dock-icon wa-unread-mobile-icon">
        <i class="bi bi-inboxes" aria-hidden="true"></i>
        <% if owner_unread_intake_count.positive? %>
          <span class="wa-unread-count wa-unread-count--mobile" aria-label="<%= t("intake.unread_count", count: owner_unread_intake_count) %>"><%= owner_unread_badge_label %></span>
        <% end %>
      </span>
      <span class="rc-mobile-dock-label"><%= t("requests_hub.title") %></span>
    <% end %>
  <% end %>

  <%# The library lives in the top navigation on desktop and the cabinet on mobile. %>
  <% library_active = owner_signed_in? && controller_path == "owner_artifacts" %>
  <% records_destination = library_active ? owner_artifacts_path : (owner_signed_in? ? owner_cabinet_path : consultations_path) %>
  <% records_active = library_active || (owner_signed_in? ? request.path == owner_cabinet_path : consultations_active) %>
  <%= link_to records_destination,
              class: "rc-mobile-dock-item #{'is-active' if records_active}",
              aria: { current: ("page" if records_active) } do %>
    <i class="bi <%= library_active ? 'bi-collection' : (owner_signed_in? ? 'bi-person-badge' : 'bi-list-ul') %> rc-mobile-dock-icon" aria-hidden="true"></i>
    <span class="rc-mobile-dock-label"><%= library_active ? t("artifact_library.title") : (owner_signed_in? ? t("account_hub.owner_cabinet") : t("nav.records")) %></span>
  <% end %>

  <% if admin_signed_in? && !owner_signed_in? %>
    <%= button_to(owner_signed_in? ? sign_out_path : admin_logout_path, method: :delete,
                  form: { class: "rc-mobile-dock-form" },
                  class: "rc-mobile-dock-item",
                  aria: { label: t("nav.admin_sign_out") }) do %>
      <i class="bi bi-box-arrow-right rc-mobile-dock-icon" aria-hidden="true"></i>
      <span class="rc-mobile-dock-label"><%= t("nav.sign_out") %></span>
    <% end %>
  <% elsif !admin_signed_in? %>
    <%= link_to sign_in_path, class: "rc-mobile-dock-item #{'is-active' if access_active}",
                aria: { current: ("page" if access_active) } do %>
      <i class="bi bi-person-circle rc-mobile-dock-icon" aria-hidden="true"></i>
      <span class="rc-mobile-dock-label"><%= t("nav.admin") %></span>
    <% end %>
  <% end %>
</nav>

<% end %>
