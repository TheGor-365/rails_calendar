<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title>Rails Calendar · AI Workspace — заявки и разработка веб-сервисов</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Rails Calendar · AI Workspace: услуги Ruby on Rails, формы, API/PostgreSQL и автоматизация. Прозрачный процесс постановки и согласования веб-задач.">
    <meta name="robots" content="index,follow">
    <link rel="canonical" href="https://rails-calendar-ai-web-production.up.railway.app/">
    <meta name="theme-color" content="#ffffff">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Rails Calendar · AI Workspace">
    <meta property="og:description" content="Четыре направления веб-разработки и понятный маршрут от запроса до согласованной задачи.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="stylesheet" href="/marketing.css">
  </head>
  <body class="marketing-page">
    <a class="mk-skip" href="#main-content">Перейти к содержимому</a>
    <header class="mk-header">
      <div class="mk-container mk-header-inner">
        <%= link_to services_path, class: "mk-brand", aria: { label: "Rails Calendar AI Workspace — обзор" } do %>
          <span class="mk-brand-icon" aria-hidden="true"><svg class="mk-icon"><use href="/workspace-icons.svg#layers"></use></svg></span>
          <span class="mk-brand-name">Rails Calendar <small>AI Workspace</small></span>
        <% end %>
        <nav class="mk-header-nav" aria-label="Главная навигация">
          <%= link_to "Услуги", "#services" %>
          <%= link_to "Как работаем", "#process", class: "mk-header-secondary" %>
          <%= link_to "Контакты", "#contact", class: "mk-header-secondary" %>
        </nav>
        <%= link_to(admin_signed_in? ? root_path : sign_in_path, class: "mk-header-access") do %>
          <svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#lock"></use></svg>
          <span><%= admin_signed_in? ? "В рабочую область" : "Вход владельца" %></span>
        <% end %>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><%= yield %></main>
    <footer class="mk-footer">
      <div class="mk-container mk-footer-inner">
        <span class="mk-footer-brand"><svg class="mk-icon" aria-hidden="true"><use href="/workspace-icons.svg#layers"></use></svg>Rails Calendar · AI Workspace</span>
        <span>Публичная витрина · Клиентские данные на сайте не принимаются</span>
      </div>
    </footer>
  </body>
</html>
