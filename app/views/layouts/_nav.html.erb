<div class="container">
  <nav aria-label="Main navigation" class="d-flex align-items-center gap-3 py-3">
    <%= link_to "Home", root_path, class: "nav-link" %>
    <%= link_to "Consultations", consultations_path, class: "nav-link" %>

    <% if admin_signed_in? %>
      <span class="text-muted">Administrator</span>
      <%= button_to "Sign out", admin_logout_path, method: :delete, class: "btn btn-outline-secondary btn-sm" %>
    <% else %>
      <%= link_to "Admin sign in", admin_login_path, class: "nav-link" %>
    <% end %>
  </nav>
</div>
