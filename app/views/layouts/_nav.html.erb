<div class="container">
  <nav aria-label="<%= t("nav.main_navigation") %>" class="app-nav d-flex flex-wrap align-items-center gap-2 py-3">
    <% brand_destination = owner_signed_in? ? workspace_path : (client_signed_in? ? client_home_path : root_path) %>
    <%= link_to brand_destination, class: "app-brand", aria: { label: t("nav.home") } do %>
      <span class="rc-brand-symbol" aria-hidden="true"><i class="bi bi-calendar2-check"></i></span>
      <span class="ws-brand-name">Rails Calendar<small>AI Workspace</small></span>
    <% end %>

    <%# Only the brand and this owner shortcut remain visible in the mobile header.
        The existing .ms-auto utility group is intentionally hidden at 767px. %>
    <% if owner_signed_in? %>
      <%= link_to owner_ai_assistant_path,
                  class: "rc-action rc-action--soft wa-ai-header-shortcut",
                  aria: { label: t("owner_ai_assistant.nav_label"),
                          current: ("page" if request.path == owner_ai_assistant_path) } do %>
        <%= rc_icon_label("stars", t("owner_ai_assistant.mobile_nav_label")) %>
      <% end %>
    <% end %>

    <% owner_workspace_active = owner_signed_in? && controller_path == "workspace" && action_name == "home" %>
    <% owner_ai_active = owner_signed_in? && (controller_path == "owner_ai_assistant" || controller_path == "owner_ai_conversations") %>
    <% owner_requests_active = owner_signed_in? && (
         controller_path == "admin/project_intakes" && action_name == "index" ||
         controller_path == "owner_invitations" ||
         controller_path == "owner_requirements" ||
         controller_path == "project_intakes" && action_name == "show"
       ) %>
    <% owner_notifications_active = owner_signed_in? && controller_path == "owner_notifications" %>
    <% owner_library_active = owner_signed_in? && controller_path == "owner_artifacts" %>
    <% client_cabinet_active = client_signed_in? && ([client_home_path, client_cabinet_path].include?(request.path) || (controller_path == "client_requests" && %w[show review].include?(action_name))) %>
    <% client_creation_active = client_signed_in? && controller_path == "client_requests" && %w[new create].include?(action_name) %>
    <div class="rc-nav-group" aria-label="<%= t("nav.workspace_sections") %>">
      <% if client_signed_in? %>
        <%= link_to rc_icon_label("grid-1x2", t("nav.client_home")), client_home_path,
                      class: "rc-nav-link #{'active' if client_cabinet_active}",
                      aria: { current: ("page" if [client_home_path, client_cabinet_path].include?(request.path)) } %>
        <% if ClientRequestPilot.enabled?(request: request) %>
          <%= link_to rc_icon_label("clipboard2-plus", t("client_requests.new_action")), new_client_request_path,
                      class: "rc-nav-link #{'active' if client_creation_active}",
                      aria: { current: ("page" if client_creation_active) } %>
        <% end %>
      <% else %>
      <% if owner_signed_in? %>
        <%= link_to rc_icon_label("grid-1x2", t("nav.workspace")), workspace_path, class: "rc-nav-link #{'active' if owner_workspace_active}", aria: { current: ("page" if owner_workspace_active) } %>
        <%= link_to rc_icon_label("person-badge", t("account_hub.owner_cabinet")), owner_cabinet_path, class: "rc-nav-link #{'active' if request.path == owner_cabinet_path || controller_path == 'owner_setup'}", aria: { current: ("page" if request.path == owner_cabinet_path || controller_path == 'owner_setup') } %>
        <%= link_to owner_ai_assistant_path,
                    class: "rc-nav-link wa-ai-nav-entry #{'active' if owner_ai_active}",
                    aria: { current: ("page" if owner_ai_active) } do %>
          <%= rc_icon_label("stars", t("owner_ai_assistant.nav_label")) %>
        <% end %>
        <%= link_to owner_notifications_path, class: "rc-nav-link #{'active' if owner_notifications_active}",
                    aria: { current: ("page" if owner_notifications_active) } do %>
          <%= rc_icon_label("bell", t("notifications.title")) %>
          <% if owner_unread_activity_count.positive? %>
            <span class="wa-unread-count" aria-label="<%= t("notifications.unread") %>"><%= [owner_unread_activity_count, 99].min %><%= '+' if owner_unread_activity_count > 99 %></span>
          <% end %>
        <% end %>
        <%= link_to rc_icon_label("collection", t("artifact_library.title")), owner_artifacts_path,
                    class: "rc-nav-link #{'active' if owner_library_active}",
                    aria: { current: ("page" if owner_library_active) } %>
      <% end %>
      <%= link_to root_path,
                  class: "rc-nav-link #{'active' if controller_name == 'pages' && action_name == 'home'}",
                  aria: { current: ("page" if controller_name == 'pages' && action_name == 'home') } do %>
        <%= rc_icon_label("calendar3", t("nav.calendar")) %>
      <% end %>
      <%= link_to calendar_day_path(date: Time.zone.today.iso8601),
                  class: "rc-nav-link #{'active' if controller_name == 'pages' && %w[day hour].include?(action_name)}",
                  aria: { current: ("page" if controller_name == 'pages' && %w[day hour].include?(action_name)) } do %>
        <%= rc_icon_label("clock-history", t("nav.today")) %>
      <% end %>
      <%= link_to consultations_path,
                  class: "rc-nav-link #{'active' if controller_name == 'consultations'}",
                  aria: { current: ("page" if controller_name == 'consultations') } do %>
        <%= rc_icon_label("journal-text", t("nav.consultations")) %>
      <% end %>
      <% if admin_signed_in? || ENV["RC_INTAKE_PUBLIC_DEMO"] == "true" %>
        <%= link_to rc_icon_label("clipboard2-plus", t("nav.ai_request")), new_project_intake_path,
                    class: "rc-nav-link #{'active' if controller_path == 'project_intakes' && action_name == 'new'}" %>
        <% if admin_signed_in? %>
          <%= link_to admin_project_intakes_path,
                      class: "rc-nav-link wa-inbox-nav #{'active' if owner_requests_active}", aria: { current: ("page" if owner_requests_active) } do %>
            <%= rc_icon_label("inboxes", t("requests_hub.title")) %>
            <% if owner_signed_in? && owner_unread_intake_count.positive? %>
              <span class="wa-unread-count" aria-label="<%= t("intake.unread_count", count: owner_unread_intake_count) %>"><%= owner_unread_badge_label %></span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <% end %>
    </div>

    <div class="ms-auto d-flex align-items-center gap-2">
      <%= render "shared/locale_switcher" %>

      <%= link_to services_path, class: "ws-header-services", aria: { label: t("nav.open_services") } do %>
        <%= rc_icon_label("grid-1x2", t("nav.services")) %>
      <% end %>
      <% if owner_signed_in? %>
        <% if (avatar = local_owner_avatar_attachment(current_user)) %>
          <%= link_to owner_cabinet_path, class: "ws-nav-avatar-link", aria: { label: t("account_hub.avatar_title") } do %>
            <%= image_tag owner_avatar_file_path(avatar), class: "ws-nav-avatar", alt: t("account_hub.avatar_alt") %>
          <% end %>
        <% end %>
        <span class="rc-nav-admin d-none d-sm-inline" title="Owner session"><%= t("nav.owner") %>: <%= current_user.email %></span>
        <%= button_to rc_icon_label("box-arrow-right", t("nav.sign_out")), sign_out_path, method: :delete, class: "rc-action rc-action--quiet rc-action--small" %>
      <% elsif client_signed_in? %>
        <% if (avatar = local_client_avatar_attachment(current_user)) %>
          <%= link_to client_cabinet_path, class: "ws-nav-avatar-link", aria: { label: t("account_hub.client_avatar_title") } do %>
            <%= image_tag client_avatar_file_path(avatar), class: "ws-nav-avatar", alt: t("account_hub.client_avatar_alt") %>
          <% end %>
        <% end %>
        <%= button_to rc_icon_label("box-arrow-right", t("nav.sign_out")), sign_out_path,
                      method: :delete, class: "rc-action rc-action--quiet rc-action--small" %>
      <% elsif admin_signed_in? %>
        <span class="rc-nav-admin d-none d-sm-inline"><%= t("nav.administrator") %></span>
        <%= button_to rc_icon_label("box-arrow-right", t("nav.sign_out")), admin_logout_path, method: :delete, class: "rc-action rc-action--quiet rc-action--small" %>
      <% else %>
        <%= link_to rc_icon_label("box-arrow-in-right", t("nav.sign_in")), sign_in_path, class: "rc-action rc-action--quiet rc-action--small" %>
      <% end %>
    </div>
  </nav>
</div>
