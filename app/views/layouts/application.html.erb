<!DOCTYPE html>
<html>
  <head>
    <title>Consult book</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body>
    <header>
      <%= render "layouts/nav" %>
    </header>

    <% if notice.present? %>
      <p class="container alert alert-success" role="status"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="container alert alert-danger" role="alert"><%= alert %></p>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
