<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Rails Calendar</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <meta name="theme-color" content="#ffffff">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body class="app-shell <%= "wa-ai-enabled" if owner_signed_in? %>" data-controller="ui-feedback rc-select wa-page-dialog"
        data-action="turbo:submit-start->ui-feedback#start turbo:submit-end->ui-feedback#finish turbo:load@document->ui-feedback#reset">
    <a class="skip-link" href="#main-content"><%= t("nav.skip") %></a>
    <header class="app-header">
      <%= render "layouts/nav" %>
    </header>

    <main id="main-content" class="pb-5" tabindex="-1" data-wa-dialog-outcome="<%= flash[:wa_dialog_outcome] if %w[advance replace].include?(flash[:wa_dialog_outcome]) %>">
      <% if notice.present? %>
        <p class="container rc-notice rc-notice--success mt-3" role="status"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="container rc-notice rc-notice--error mt-3" role="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
    <dialog class="wa-page-dialog" aria-labelledby="wa-page-dialog-title" data-wa-page-dialog-target="dialog" data-action="cancel->wa-page-dialog#cancel click->wa-page-dialog#backdrop">
      <div class="wa-page-dialog__shell">
        <header class="wa-page-dialog__header">
          <button type="button" class="rc-action rc-action--quiet wa-page-dialog__back" aria-label="<%= t("nav.back", default: { ru: "Назад", en: "Back", hy: "Հետ", es: "Atrás" }.fetch(I18n.locale.to_sym, "Back")) %>" data-wa-page-dialog-target="backButton" data-action="wa-page-dialog#back" disabled><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
          <strong id="wa-page-dialog-title" data-wa-page-dialog-target="heading"></strong>
          <button type="button" class="rc-action rc-action--quiet" aria-label="<%= t("marketing.close_dialog") %>" data-action="wa-page-dialog#close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </header>
        <nav class="wa-page-dialog__trail" aria-label="<%= { ru: "История переходов", en: "Navigation history", hy: "Նավարկման պատմություն", es: "Historial de navegación" }.fetch(I18n.locale.to_sym, "Navigation history") %>" data-wa-page-dialog-target="trail" hidden></nav>
        <iframe class="wa-page-dialog__page" src="about:blank" title="<%= t("activity_journal.open") %>" data-wa-embedded-page data-wa-page-dialog-target="page" data-wa-discard-message="<%= { ru: "Есть несохранённые изменения. Выйти без сохранения?", en: "Discard unsaved changes?", hy: "Չպահված փոփոխություններ կան։ Դուրս գա՞լ առանց պահպանելու։", es: "Hay cambios sin guardar. ¿Salir sin guardar?" }.fetch(I18n.locale.to_sym, "Discard unsaved changes?") %>"></iframe>
      </div>
    </dialog>
    <% discard_copy = {
      ru: ["Несохранённые изменения", "Изменения не сохранены. Если продолжить, они будут потеряны.", "Продолжить редактирование", "Выйти без сохранения"],
      en: ["Unsaved changes", "Your changes have not been saved. Continuing will discard them.", "Keep editing", "Discard changes"],
      hy: ["Չպահված փոփոխություններ", "Փոփոխությունները չեն պահպանվել։ Շարունակելու դեպքում դրանք կկորչեն։", "Շարունակել խմբագրումը", "Դուրս գալ առանց պահպանելու"],
      es: ["Cambios sin guardar", "Los cambios no se han guardado. Si continúas, se perderán.", "Seguir editando", "Descartar cambios"]
    }.fetch(I18n.locale.to_sym, ["Unsaved changes", "Your changes have not been saved. Continuing will discard them.", "Keep editing", "Discard changes"]) %>
    <dialog class="wa-confirm-dialog" role="alertdialog" aria-labelledby="wa-discard-title" aria-describedby="wa-discard-description"
            data-wa-page-dialog-target="confirmation" data-action="cancel->wa-page-dialog#cancelDiscard click->wa-page-dialog#discardBackdrop">
      <div class="wa-confirm-dialog__body">
        <span class="wa-confirm-dialog__icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
        <h2 id="wa-discard-title"><%= discard_copy[0] %></h2>
        <p id="wa-discard-description"><%= discard_copy[1] %></p>
        <div class="wa-confirm-dialog__actions">
          <button type="button" class="rc-action rc-action--quiet" data-wa-page-dialog-target="keepEditing" data-action="wa-page-dialog#cancelDiscard" autofocus><%= discard_copy[2] %></button>
          <button type="button" class="rc-action rc-action--danger" data-action="wa-page-dialog#confirmDiscard"><%= discard_copy[3] %></button>
        </div>
      </div>
    </dialog>
    <%= render "layouts/mobile_nav" %>
    <%= render "shared/owner_ai_launcher" if owner_signed_in? %>
  </body>
</html>
