<!DOCTYPE html>
<html>
  <head>
    <title>Rails Calendar</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body class="app-shell">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="app-header">
      <%= render "layouts/nav" %>
    </header>

    <main id="main-content" class="pb-5" tabindex="-1">
      <% if notice.present? %>
        <p class="container rc-notice rc-notice--success mt-3" role="status"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="container rc-notice rc-notice--error mt-3" role="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
