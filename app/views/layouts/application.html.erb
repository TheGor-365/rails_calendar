<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Rails Calendar</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <meta name="theme-color" content="#ffffff">
    <% if %w[advance replace].include?(flash[:wa_dialog_outcome]) %>
      <meta name="wa-dialog-outcome" content="<%= flash[:wa_dialog_outcome] %>">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body class="app-shell <%= "wa-ai-enabled" if owner_signed_in? %>" data-controller="ui-feedback rc-select wa-page-dialog"
        data-action="turbo:submit-start->ui-feedback#start turbo:submit-end->ui-feedback#finish turbo:load@document->ui-feedback#reset">
    <a class="skip-link" href="#main-content"><%= t("nav.skip") %></a>
    <header class="app-header">
      <%= render "layouts/nav" %>
    </header>

    <main id="main-content" class="pb-5" tabindex="-1">
      <% if notice.present? %>
        <p class="container rc-notice rc-notice--success mt-3" role="status"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="container rc-notice rc-notice--error mt-3" role="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
    <dialog class="wa-page-dialog" aria-labelledby="wa-page-dialog-title" data-wa-page-dialog-target="dialog" data-action="cancel->wa-page-dialog#cancel click->wa-page-dialog#backdrop">
      <div class="wa-page-dialog__shell">
        <header class="wa-page-dialog__header">
          <button type="button" class="rc-action rc-action--quiet wa-page-dialog__back" aria-label="<%= t("nav.back", default: { ru: "Назад", en: "Back", hy: "Հետ", es: "Atrás" }.fetch(I18n.locale.to_sym, "Back")) %>" data-wa-page-dialog-target="backButton" data-action="wa-page-dialog#back" disabled><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
          <strong id="wa-page-dialog-title" data-wa-page-dialog-target="heading"></strong>
          <button type="button" class="rc-action rc-action--quiet" aria-label="<%= t("marketing.close_dialog") %>" data-action="wa-page-dialog#close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </header>
        <iframe class="wa-page-dialog__page" src="about:blank" title="<%= t("activity_journal.open") %>" data-wa-embedded-page data-wa-page-dialog-target="page" data-wa-discard-message="<%= { ru: "Есть несохранённые изменения. Выйти без сохранения?", en: "Discard unsaved changes?", hy: "Չպահված փոփոխություններ կան։ Դուրս գա՞լ առանց պահպանելու։", es: "Hay cambios sin guardar. ¿Salir sin guardar?" }.fetch(I18n.locale.to_sym, "Discard unsaved changes?") %>"></iframe>
      </div>
    </dialog>
    <%= render "layouts/mobile_nav" %>
    <%= render "shared/owner_ai_launcher" if owner_signed_in? %>
  </body>
</html>
