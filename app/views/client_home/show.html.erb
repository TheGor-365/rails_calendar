<div class="container ws-client-home my-4 my-sm-5">
  <div class="ws-client-heading">
    <span class="eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> <%= t("client.eyebrow") %></span>
    <h1 class="page-title"><%= t("client.title") %></h1>
    <p class="rc-muted"><%= @pilot_enabled ? t("client_requests.pilot_intro") : t("client.description") %></p>
  </div>

  <section class="ws-client-panel" aria-labelledby="client-start-title">
    <div class="ws-client-icon" aria-hidden="true"><i class="bi bi-grid-1x2"></i></div>
    <h2 id="client-start-title"><%= @pilot_enabled ? t(@client_requests.any? ? "client_requests.pilot_active_title" : "client_requests.pilot_start_title") : t("client.panel_title") %></h2>
    <p><%= @pilot_enabled ? t("client_requests.home_description") : t("client.panel_body") %></p>
    <% if @pilot_enabled %>
      <%= link_to rc_icon_label("clipboard2-plus", t("client_requests.new_action")), new_client_request_path, class: "rc-action rc-action--primary" %>
    <% end %>
    <%= link_to rc_icon_label("globe", t("client.overview")), services_path, class: "rc-action rc-action--quiet" %>
  </section>

  <% if @pilot_enabled %>
    <section class="surface-panel p-3 p-sm-4 mt-4" aria-labelledby="client-requests-heading">
      <h2 id="client-requests-heading" class="h4"><i class="bi bi-inboxes me-2" aria-hidden="true"></i><%= t("client_requests.list_title") %></h2>
      <% if @client_requests.any? %>
        <ul class="rc-record-list">
          <% @client_requests.each do |item| %>
            <li class="rc-record">
              <h3 class="h5"><%= link_to rc_icon_label("arrow-up-right", item.title), client_request_path(item), class: "rc-text-link" %></h3>
              <p class="rc-muted mb-0"><%= rc_intake_type(item.project_type) %> · <%= rc_intake_status(item.status) %></p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="rc-muted"><%= t("client_requests.empty") %></p>
      <% end %>
    </section>
  <% end %>
</div>
