<div class="container ws-account-page ws-client-home my-4 my-sm-5" id="client-cabinet">
  <% banner_metadata = capture do %>
    <div class="ws-account-meta">
        <span class="ws-account-chip"><i class="bi bi-shield-check" aria-hidden="true"></i><%= t("account_hub.verified") %></span>
        <span class="ws-account-chip"><i class="bi bi-envelope" aria-hidden="true"></i><%= current_user.email %></span>
      </div>
  <% end %>
  <% banner_accessory = capture do %>
    <div class="ws-account-hero-symbol ws-account-avatar-frame" id="client-avatar"
         data-controller="wa-avatar-editor"
         data-wa-avatar-editor-success-value="<%= t("account_hub.avatar_crop_ready") %>"
         data-wa-avatar-editor-failure-value="<%= t("account_hub.avatar_crop_failed") %>">
      <% if (avatar = local_client_avatar_attachment(current_user)) %>
        <%= image_tag client_avatar_file_path(avatar), class: "ws-account-avatar",
              alt: t("account_hub.client_avatar_alt"), loading: "lazy" %>
      <% else %>
        <i class="bi bi-person-circle ws-account-avatar-placeholder" aria-hidden="true"></i>
      <% end %>
      <% if local_client_avatar_enabled? %>
        <details class="ws-avatar-edit">
          <summary class="ws-avatar-edit-trigger" title="<%= t("account_hub.avatar_edit") %>"
                   aria-label="<%= t("account_hub.avatar_edit") %>">
            <i class="bi bi-pencil-square" aria-hidden="true"></i>
          </summary>
          <div class="ws-avatar-edit-panel">
            <div class="ws-avatar-edit-panel__heading">
              <span class="ws-avatar-edit-panel__icon"><i class="bi bi-image" aria-hidden="true"></i></span>
              <div>
                <strong><%= t("account_hub.client_avatar_title") %></strong>
                <p><%= t("account_hub.avatar_crop_hint") %></p>
              </div>
            </div>
            <%= form_with url: client_avatars_path, method: :post, multipart: true,
                html: { id: "client-avatar-form", class: "ws-account-avatar-form",
                        data: { action: "submit->wa-avatar-editor#guard" } } do %>
              <div class="wa-file-drop">
                <label for="client-avatar-file">
                  <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                  <%= t("account_hub.avatar_file") %>
                </label>
                <%= file_field_tag "avatar[file]", id: "client-avatar-file",
                    accept: "image/jpeg,image/png,image/webp", required: true,
                    data: { wa_avatar_editor_target: "file", action: "change->wa-avatar-editor#prepare" } %>
              </div>
              <div class="ws-avatar-edit-crop-preview" aria-label="<%= t("account_hub.client_avatar_alt") %>">
                <img class="ws-avatar-edit-crop-preview__image"
                     data-wa-avatar-editor-target="preview"
                     alt="<%= t("account_hub.client_avatar_alt") %>" hidden>
              </div>
              <p class="ws-avatar-edit-status" role="status" aria-live="polite"
                 data-wa-avatar-editor-target="status"></p>
              <%= button_tag type: "submit", class: "rc-action rc-action--primary",
                    data: { wa_avatar_editor_target: "submit" } do %>
                <%= rc_icon_label("check2", t("account_hub.avatar_upload")) %>
              <% end %>
            <% end %>
            <p class="rc-hint ws-avatar-edit-panel__footer"><i class="bi bi-shield-lock" aria-hidden="true"></i>
              <%= t("account_hub.client_avatar_hint") %></p>
          </div>
        </details>
      <% end %>
    </div>
  <% end %>
  <%= render "shared/wa_banner", variant: :account, icon: "person-check", path: t("account_hub.client_eyebrow"), title: t("nav.client_home"), extra_class: "ws-account-hero ws-client-heading", metadata: banner_metadata, accessory: banner_accessory, description: (@pilot_enabled ? t("client_requests.pilot_intro") : t("client.description")) %>

  <section class="ws-account-overview" aria-label="<%= t('account_hub.client_account') %>">
    <div class="ws-account-metric">
      <span class="ws-account-metric-icon"><i class="bi bi-person-check" aria-hidden="true"></i></span>
      <small><%= t("account_hub.client_account") %></small>
      <strong><%= t("account_hub.verified") %></strong>
      <span><%= t("account_hub.private_scope") %></span>
    </div>
    <div class="ws-account-metric">
      <span class="ws-account-metric-icon"><i class="bi bi-inboxes" aria-hidden="true"></i></span>
      <small><%= t("account_hub.client_requests") %></small>
      <strong><%= @client_requests.size %></strong>
      <span><%= t("account_hub.client_request_desc") %></span>
    </div>
    <div class="ws-account-metric">
      <span class="ws-account-metric-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
      <small><%= t("account_hub.public_visibility") %></small>
      <strong><%= t("account_hub.not_published") %></strong>
      <span><%= t("account_hub.client_info") %></span>
    </div>
  </section>

  <div class="ws-account-content">
    <div class="ws-account-main">
      <section class="ws-client-panel ws-account-feature-panel" aria-labelledby="client-start-title">
        <div class="ws-client-icon" aria-hidden="true"><i class="bi bi-grid-1x2"></i></div>
        <h2 id="client-start-title"><%= @pilot_enabled ? t(@client_requests.any? ? "client_requests.pilot_active_title" : "client_requests.pilot_start_title") : t("client.panel_title") %></h2>
        <p><%= @pilot_enabled ? t("client_requests.home_description") : t("client.panel_body") %></p>
        <div class="ws-account-actions">
          <% if @pilot_enabled %>
            <%= link_to rc_icon_label("clipboard2-plus", t("client_requests.new_action")), new_client_request_path, class: "rc-action rc-action--primary" %>
          <% end %>
          <%= link_to rc_icon_label("globe", t("client.overview")), services_path, class: "rc-action rc-action--quiet" %>
        </div>
      </section>

      <% if @pilot_enabled %>
        <section class="surface-panel ws-account-panel mt-3" aria-labelledby="client-requests-heading">
          <div class="ws-account-section-heading">
            <div>
              <p class="eyebrow"><%= t("account_hub.client_request_list") %></p>
              <h2 id="client-requests-heading"><i class="bi bi-inboxes me-2" aria-hidden="true"></i><%= t("client_requests.list_title") %></h2>
            </div>
          </div>
          <% if @client_requests.any? %>
            <ul class="rc-record-list">
              <% @client_requests.each do |item| %>
                <li class="rc-record wa-client-home__request">
                  <% pending_invitation = item.client_request_invitation %>
                  <% needs_completion = pending_invitation.present? && pending_invitation.submitted_at.nil? %>
                  <div class="wa-client-home__request-head">
                    <h3 class="h5 mb-0">
                      <%= link_to rc_icon_label(needs_completion ? "pencil-square" : "arrow-up-right", item.title),
                          needs_completion ? edit_client_request_path(item) : client_request_path(item), class: "rc-text-link" %>
                    </h3>
                    <div class="wa-client-home__request-meta">
                      <% if needs_completion %>
                        <span class="rc-status-pill rc-status-pill--muted">
                          <i class="bi bi-pencil-square" aria-hidden="true"></i>
                          <%= t("e2_resume.draft") %>
                        </span>
                      <% end %>
                      <span class="rc-status-pill rc-status-pill--muted"><i class="bi bi-grid-1x2" aria-hidden="true"></i><%= rc_intake_type(item.project_type) %></span>
                      <span class="rc-status-pill"><i class="bi bi-circle-half" aria-hidden="true"></i><%= rc_intake_status(item.status) %></span>
                    </div>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="rc-empty-state wa-client-home__empty">
              <span class="rc-empty-state__icon" aria-hidden="true"><i class="bi bi-inboxes"></i></span>
              <p><%= t("client_requests.empty") %></p>
              <%= link_to rc_icon_label("clipboard2-plus", t("client_requests.new_action")), new_client_request_path,
                          class: "rc-action rc-action--primary rc-action--small" %>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>
    <aside class="ws-account-aside">
      <section class="ws-account-side-panel">
        <span class="ws-account-side-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
        <h2><%= t("account_hub.client_info") %></h2>
        <p><%= t("account_hub.client_privacy") %></p>
        <div class="ws-account-fact"><span><%= t("account_hub.client_account") %></span><strong><%= t("account_hub.verified") %></strong></div>
        <div class="ws-account-fact"><span><%= t("account_hub.public_visibility") %></span><strong><%= t("account_hub.not_published") %></strong></div>
      </section>
      <section class="ws-account-side-panel ws-account-side-panel--soft">
        <h2><%= t("account_hub.client_services") %></h2>
        <p><%= t("client.description") %></p>
        <%= link_to rc_icon_label("globe", t("client.overview")), services_path, class: "rc-action rc-action--quiet rc-action--small" %>
      </section>
    </aside>
  </div>
</div>
